module std from @std()

# Noise-floor analyzer for the benchmark log (test/benchmark/stats.csv).
#
# The log mixes every session ever recorded, so a noise floor is only
# meaningful over one same-build campaign: the rows written at or after a
# fixed epoch. For each workload this prints the compute_pct series in run
# order, its range, the largest step between consecutive runs, and the
# mean. The two spread figures are what a performance gate has to sit above.
#
#   doxa run scripts/noise.doxa -- --since <epoch> [--path <csv>]

function roundToString(value :: float, precision :: int) returns string {
    var str_value is @string(value)
    var decimal_index is -1
    each char at i in str_value {
        if decimal_index < 0 then {
            if char == "." then decimal_index is i
        }
    }
    if(@length(str_value) < decimal_index + precision + 1) then {
        const diff is decimal_index + precision + 1 - @length(str_value)
        each i in 0 to diff - 1 {
            str_value += "0"
        }
        return str_value
    }
    return @slice(str_value, 0, decimal_index + precision + 1)
}

function contains(names :: string[], needle :: string) returns tetra {
    var found is false
    each name in names {
        if name == needle then {
            found is true
        }
    }
    return found
}

# Record a complete CSV row if it falls inside the campaign window.
# `fields` is the row in log column order; rows that are not nine columns
# wide (the header) or predate the window are counted by the caller.
function takeRow(fields :: string[], since :: int, ^order :: string[], ^names :: string[], ^pcts :: float[], ^kept :: int) {
    if @length(fields) != 9 or fields[0] == "test" then {
        return
    }
    const date is @int(fields[8])
    if date < since then {
        return
    }
    const test is fields[0]
    @push(names, test)
    @push(pcts, @float(fields[6]))
    if not contains(order, test) then {
        @push(order, test)
    }
    kept += 1
}

public entry function main() {
    var since is 0
    var path is "test/benchmark/stats.csv"

    const args is std.process.args() as string[] else {
        std.io.println("Error getting arguments")
        return
    }
    each arg at i in args {
        if arg == "--since" then {
            if i + 1 < @length(args) then {
                since is @int(args[i + 1])
            }
        }
        else if arg == "--path" then {
            if i + 1 < @length(args) then {
                path is args[i + 1]
            }
        }
    }
    if since == 0 then {
        std.io.println("usage: doxa run scripts/noise.doxa -- --since <epoch> [--path <csv>]")
        return
    }

    const content is std.file.read(path) as string else {
        std.io.println("cannot read {path}")
        return
    }

    var order :: string[]
    var names :: string[]
    var pcts :: float[]
    var fields :: string[]
    var field is ""
    var kept is 0
    var seen is 0

    each c in content {
        if c == "," then {
            @push(fields, field)
            field is ""
        }
        else if c == "\n" then {
            @push(fields, field)
            field is ""
            seen += 1
            takeRow(fields, since, ^order, ^names, ^pcts, ^kept)
            @clear(fields)
        }
        else if c != "\u{d}" then {
            field += c
        }
    }
    # tolerate a final row that the log did not terminate with a newline
    if @length(field) > 0 then {
        @push(fields, field)
        seen += 1
        takeRow(fields, since, ^order, ^names, ^pcts, ^kept)
    }

    std.io.println("window: date >= {since}   rows kept: {kept} of {seen}   ({path})")
    std.io.println("test\t| n\t| min\t| max\t| spread\t| max step\t| mean\t| series")

    var worst_spread is 0.0
    var worst_spread_on is ""
    var worst_step is 0.0
    var worst_step_on is ""

    each name in order {
        var vals :: float[]
        each pct at i in pcts {
            if names[i] == name then {
                @push(vals, pct)
            }
        }
        var lo is vals[0]
        var hi is vals[0]
        var sum is 0.0
        var step is 0.0
        each v at i in vals {
            if v < lo then {
                lo is v
            }
            if v > hi then {
                hi is v
            }
            sum += v
            if i > 0 then {
                var d is v - vals[i - 1]
                if d < 0.0 then {
                    d is 0.0 - d
                }
                if d > step then {
                    step is d
                }
            }
        }
        const n is @length(vals)
        const mean is sum / @float(n)
        const spread is hi - lo
        if spread > worst_spread then {
            worst_spread is spread
            worst_spread_on is name
        }
        if step > worst_step then {
            worst_step is step
            worst_step_on is name
        }
        var series is ""
        each v at i in vals {
            if i > 0 then {
                series += " "
            }
            series += roundToString(v, 2)
        }
        std.io.println("{name}\t| {n}\t| {roundToString(lo, 2)}\t| {roundToString(hi, 2)}\t| {roundToString(spread, 2)}\t| {roundToString(step, 2)}\t| {roundToString(mean, 2)}\t| {series}")
    }

    std.io.println("")
    std.io.println("worst spread: {roundToString(worst_spread, 2)} points ({worst_spread_on})")
    std.io.println("worst step between consecutive runs: {roundToString(worst_step, 2)} points ({worst_step_on})")
}
