def archive_releases(directories :: string[]) {
    each directory in directories {
        archive_release(directory)
    }
}

function main() returns int {
    if not run_command("zig build release", "Building release binaries for all platforms") then {
        std.io.println("Release build failed")
        return 1
    }
    print("Release build completed successfully")
    archive_releases(DIRECTORIES)
    return 0
}

if __name__ == "__main__":
    sys.exit(main())