module std from @std()

const release_dir is "doxa"

const directories is [
    "macos-x64",
    "macos-arm64",
    "linux-x64",
    "linux-arm64",
    "windows-x64",
]

function run_command(cmd :: string, description :: string is "") returns tetra {
    
    if @length(description) < 1 then {
        std.io.println("{description}...")
    }
    std.io.println("Running: {cmd}")
    const res is std.process.exec(cmd) as int else {
        std.io.println("Error: {res}")
        return false
    }
    if res == 0 then return true 
    std.io.println("Exit code: {res}")
    return false
}

