module error from "../error.doxa"
module zerr from "../zerr/zerr.doxa"

# How a child process ended, as Zig's `std.process.Child.Term` reports it.
public enum TermKind {
    Exited,
    Signal,
    Stopped,
    Unknown,
}

# How a child process ended. `code` is the exit status for `Exited`, the signal
# number for `Signal` and `Stopped`, and the raw status for `Unknown`.
public struct Term {
    public kind :: TermKind,
    public code :: int,

    # Whether the child exited with status 0.
    public method succeeded() returns tetra {
        return this.kind == TermKind.Exited and this.code == 0
    }
}

# A captured run: how the child ended and everything it wrote. A non-zero exit
# is part of the result, not an error.
public struct Run {
    public term :: Term,
    public stdout :: string,
    public stderr :: string,
}

struct EnvValue {
    public found :: tetra,
    public value :: string,
}

zig Process {
    const std = @import("std");
    const builtin = @import("builtin");

    extern fn doxa_argc() callconv(.c) i32;
    extern fn doxa_argv(index: i32) callconv(.c) ?[*:0]const u8;
    extern fn doxa_getenv(name_ptr: ?[*]const u8, name_len: u64, out_len: *u64) callconv(.c) ?[*]const u8;
    extern fn doxa_environ() callconv(.c) ?*const std.process.Environ.Map;

    // `std.process.spawn` allocates the child's environment block and command
    // line through the `Io`'s allocator. `std.Io.Threaded.global_single_threaded`
    // is deliberately built with a failing allocator, so spawning through it
    // fails with `error.OutOfMemory`. The process layer therefore owns a
    // single-threaded `Io` backed by the page allocator.
    fn processIo() std.Io {
        const State = struct {
            var threaded: std.Io.Threaded = undefined;
            var initialized: bool = false;
        };
        if (!State.initialized) {
            State.threaded = std.Io.Threaded.init_single_threaded;
            State.threaded.allocator = std.heap.page_allocator;
            // `init_single_threaded` starts with an empty environment on POSIX,
            // so a child spawned through it would inherit nothing: no PATH, no
            // HOME. Point the Io at this process's real environment.
            State.threaded.environ = .{ .process_environ = .{ .block = processEnvironBlock() } };
            State.threaded.environ_initialized = false;
            State.initialized = true;
        }
        return State.threaded.io();
    }

    fn processEnvironBlock() std.process.Environ.Block {
        if (builtin.os.tag == .windows) return .global;
        const c_environ = std.c.environ;
        var count: usize = 0;
        while (c_environ[count] != null) : (count += 1) {}
        return .{ .slice = c_environ[0..count :null] };
    }

    // Memory for one call, reset when the next call begins. The wrapper copies
    // every returned string into the caller's arena before returning, so
    // nothing here outlives the call that made it.
    fn scratch() std.mem.Allocator {
        const State = struct {
            var arena: std.heap.ArenaAllocator = .init(std.heap.page_allocator);
        };
        _ = State.arena.reset(.{ .retain_with_limit = 64 * 1024 });
        return State.arena.allocator();
    }

    // On Windows, `cmd /C <input>` is serialized by Zig with
    // CommandLineToArgvW escaping, which cmd.exe re-parses with different
    // rules: quotes arrive as literal `\"` and quoted paths break. Passing the
    // command through an environment variable (`shellEnviron`) and invoking it
    // with `call` hands cmd the raw text and preserves normal `%VAR%` expansion.
    // cmd treats an empty variable as unset, so an empty command runs cmd's
    // no-op instead, and exits 0 as `sh -c ""` does.
    fn shellArgv(alloc: std.mem.Allocator, input: []const u8) ![]const []const u8 {
        if (builtin.os.tag == .windows) {
            if (input.len == 0) return &.{ "cmd", "/d", "/s", "/c", "rem" };
            return &.{ "cmd", "/d", "/s", "/c", "call", "%DOXA_EXEC_CMD%" };
        }
        return alloc.dupe([]const u8, &.{ "sh", "-c", input });
    }

    fn shellEnviron(alloc: std.mem.Allocator, input: []const u8) !?*const std.process.Environ.Map {
        if (builtin.os.tag == .windows) return try environOf(alloc, &.{"DOXA_EXEC_CMD"}, &.{input});
        return null;
    }

    fn argvOf(alloc: std.mem.Allocator, program: []const u8, args: []const []const u8) ![]const []const u8 {
        const argv = try alloc.alloc([]const u8, args.len + 1);
        argv[0] = program;
        @memcpy(argv[1..], args);
        return argv;
    }

    // The parent's environment with the given `KEY`/`VALUE` overrides
    // applied, or null (inherit it unchanged) when there are none.
    fn environOf(alloc: std.mem.Allocator, env_keys: []const []const u8, env_values: []const []const u8) !?*const std.process.Environ.Map {
        if (env_keys.len == 0) return null;
        const env = try alloc.create(std.process.Environ.Map);
        env.* = if (doxa_environ()) |parent| try parent.clone(alloc) else .init(alloc);
        for (env_keys, env_values) |key, value| try env.put(key, value);
        return env;
    }

    fn termOf(term: std.process.Child.Term) DoxaStruct_Term {
        return switch (term) {
            .exited => |status| .{ .kind = 0, .code = status },
            .signal => |sig| .{ .kind = 1, .code = signalNumber(sig) },
            .stopped => |sig| .{ .kind = 2, .code = signalNumber(sig) },
            .unknown => |status| .{ .kind = 3, .code = status },
        };
    }

    // `std.posix.SIG` is an enum on POSIX and `void` on Windows, where no
    // child ends by a signal.
    fn signalNumber(sig: std.posix.SIG) i64 {
        if (@TypeOf(sig) == void) return 0;
        return @intFromEnum(sig);
    }

    fn wait(argv: []const []const u8, environ: ?*const std.process.Environ.Map) !DoxaStruct_Term {
        const io = processIo();
        var child = try std.process.spawn(io, .{
            .argv = argv,
            .environ_map = environ,
            .stdout = .inherit,
            .stderr = .inherit,
        });
        defer child.kill(io);
        return termOf(try child.wait(io));
    }

    fn run(alloc: std.mem.Allocator, argv: []const []const u8, environ: ?*const std.process.Environ.Map) !DoxaStruct_Run {
        const result = try std.process.run(alloc, processIo(), .{ .argv = argv, .environ_map = environ });
        return .{ .term = termOf(result.term), .stdout = result.stdout, .stderr = result.stderr };
    }

    pub fn exec(input: []const u8) @"DoxaError_zerr.ZigError"!DoxaStruct_Term {
        const alloc = scratch();
        return wait(try shellArgv(alloc, input), try shellEnviron(alloc, input));
    }

    pub fn execArgs(program: []const u8, args: []const []const u8, env_keys: []const []const u8, env_values: []const []const u8) @"DoxaError_zerr.ZigError"!DoxaStruct_Term {
        const alloc = scratch();
        return wait(try argvOf(alloc, program, args), try environOf(alloc, env_keys, env_values));
    }

    pub fn capture(input: []const u8) @"DoxaError_zerr.ZigError"!DoxaStruct_Run {
        const alloc = scratch();
        return run(alloc, try shellArgv(alloc, input), try shellEnviron(alloc, input));
    }

    pub fn captureArgs(program: []const u8, args: []const []const u8, env_keys: []const []const u8, env_values: []const []const u8) @"DoxaError_zerr.ZigError"!DoxaStruct_Run {
        const alloc = scratch();
        return run(alloc, try argvOf(alloc, program, args), try environOf(alloc, env_keys, env_values));
    }

    pub fn argCount() i64 {
        return doxa_argc();
    }

    // The caller checks `index` against `argCount`.
    pub fn argAt(index: i64) []const u8 {
        return std.mem.span(doxa_argv(@intCast(index)).?);
    }

    // The low byte, as a POSIX parent sees the status.
    pub fn exit(code: i64) void {
        std.process.exit(@truncate(@as(u64, @bitCast(code))));
    }

    pub fn cwd() @"DoxaError_zerr.ZigError"![]const u8 {
        return std.process.currentPathAlloc(processIo(), scratch());
    }

    pub fn getEnv(name: []const u8) DoxaStruct_EnvValue {
        var len: u64 = 0;
        const value = doxa_getenv(name.ptr, name.len, &len) orelse return .{ .found = false, .value = "" };
        return .{ .found = true, .value = value[0..@intCast(len)] };
    }
}

# Run `command` through the system shell (`sh -c`, or `cmd /c` on Windows).
# The child shares this process's stdout and stderr.
public function exec(command :: string) returns Term | zerr.ZigError {
    return Process.exec(command)
}

# Run `program` with `arguments`, no shell. The child shares this process's
# stdout and stderr.
public function execArgs(program :: string, arguments :: string[]) returns Term | zerr.ZigError {
    return Process.execArgs(program, arguments, [], [])
}

# `execArgs` with `env_keys[i]` set to `env_values[i]` in the child's
# environment, over this process's own.
public function execArgsEnv(program :: string, arguments :: string[], env_keys :: string[], env_values :: string[]) returns Term | zerr.ZigError {
    return Process.execArgs(program, arguments, env_keys, env_values)
}

# Whether `command` ran and exited with status 0.
public function execOk(command :: string) returns tetra {
    const term is exec(command) as Term else {
        return false
    }
    return term.succeeded()
}

# Run `command` through the system shell and capture what it writes.
public function execCapture(command :: string) returns Run | zerr.ZigError {
    return Process.capture(command)
}

# Run `program` with `arguments`, no shell, and capture what it writes.
public function execCaptureArgs(program :: string, arguments :: string[]) returns Run | zerr.ZigError {
    return Process.captureArgs(program, arguments, [], [])
}

# `execCaptureArgs` with `env_keys[i]` set to `env_values[i]` in the child's
# environment, over this process's own.
public function execCaptureEnv(program :: string, arguments :: string[], env_keys :: string[], env_values :: string[]) returns Run | zerr.ZigError {
    return Process.captureArgs(program, arguments, env_keys, env_values)
}

# The program's command-line arguments, the program's own path first.
public function args() returns string[] {
    var result :: string[]
    const count is argc()
    for i while i < count do i += 1 {
        @push(result, Process.argAt(i))
    }
    return result
}

public function argc() returns int {
    return Process.argCount()
}

public function argv(index :: int) returns string | error.Method {
    if index < 0 or index >= argc() then return error.Method.OutOfBounds
    return Process.argAt(index)
}

# End the program with `code`; a POSIX parent sees its low byte.
public function exit(code :: int) {
    Process.exit(code)
}

public function cwd() returns string | zerr.ZigError {
    return Process.cwd()
}

# The variable `name` in the environment the program started with, or
# `nothing` when it is not set.
public function getenv(name :: string) returns string | nothing {
    const env is Process.getEnv(name)
    if env.found then return env.value
    return nothing
}
