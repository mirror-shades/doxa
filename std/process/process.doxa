module error from "../error.doxa"

zig Process {
    const std = @import("std");
    const builtin = @import("builtin");

    extern fn doxa_argc() callconv(.c) i32;
    extern fn doxa_argv(index: i32) callconv(.c) ?[*:0]const u8;
    extern fn doxa_getenv(name_ptr: ?[*]const u8, name_len: u64, out_len: *u64) callconv(.c) ?[*]const u8;

    // `std.process.spawn` allocates the child's environment block and command
    // line through the `Io`'s allocator. `std.Io.Threaded.global_single_threaded`
    // is deliberately built with a failing allocator, so spawning through it
    // fails with `error.OutOfMemory`. The process layer therefore owns a
    // single-threaded `Io` backed by the page allocator.
    fn processIo() std.Io {
        const State = struct {
            var threaded: std.Io.Threaded = init: {
                var t = std.Io.Threaded.init_single_threaded;
                t.allocator = std.heap.page_allocator;
                break :init t;
            };
        };
        return State.threaded.io();
    }

    pub fn errorState(mode: i64, value: i64) i64 {
        const State = struct {
            var last_error_code: i64 = 0;
        };
        if (mode == 0) {
            State.last_error_code = value;
            return 0;
        }
        if (mode == 1) {
            return State.last_error_code;
        }
        if (mode == 2) {
            const code = State.last_error_code;
            State.last_error_code = 0;
            return code;
        }
        return 0;
    }

    pub fn clearLastError() void {
        _ = errorState(0, 0);
    }

    pub fn setLastError(code: i64) void {
        _ = errorState(0, code);
    }

    pub fn takeLastErrorCode() i64 {
        return errorState(2, 0);
    }

    pub fn mapCommon(err_name: []const u8) i64 {
        if (std.mem.eql(u8, err_name, "InvalidArgument")) return 1;
        if (std.mem.eql(u8, err_name, "OutOfMemory")) return 2;
        if (std.mem.eql(u8, err_name, "AccessDenied")) return 3;
        if (std.mem.eql(u8, err_name, "PermissionDenied")) return 3;
        if (std.mem.eql(u8, err_name, "NotSupported")) return 4;
        if (std.mem.eql(u8, err_name, "OperationNotSupported")) return 4;
        return -1;
    }

    pub fn mapProcessSpawn(err_name: []const u8) i64 {
        const common = mapCommon(err_name);
        if (common >= 0) return common;
        if (std.mem.eql(u8, err_name, "FileNotFound")) return 200;
        if (std.mem.eql(u8, err_name, "InvalidExe")) return 201;
        return 202;
    }

    pub fn mapProcessWait(err_name: []const u8) i64 {
        const common = mapCommon(err_name);
        if (common >= 0) return common;
        return 203;
    }

    pub fn exec_cmd(input: []const u8) i64 {
        clearLastError();
        if (input.len == 0) {
            setLastError(1);
            return 0;
        }

        const io = processIo();

        const cmd_argv = if (builtin.os.tag == .windows)
            [_][]const u8{ "cmd", "/C", input }
        else
            [_][]const u8{ "sh", "-c", input };

        var cmd = std.process.spawn(io, .{
            .argv = &cmd_argv,
            .stdout = .inherit,
            .stderr = .inherit,
        }) catch |err| {
            setLastError(mapProcessSpawn(@errorName(err)));
            return 0;
        };
        defer cmd.kill(io);

        const term = cmd.wait(io) catch |err| {
            setLastError(mapProcessWait(@errorName(err)));
            return 0;
        };

        return switch (term) {
            .exited => |code| blk: {
                if (code != 0) {
                    setLastError(207);
                    break :blk @as(i64, code);
                }
                break :blk @as(i64, code);
            },
            else => {
                setLastError(208);
                return 0;
            },
        };
    }

    pub fn exec_capture_stdout(input: []const u8) []const u8 {
        clearLastError();
        if (input.len == 0) {
            setLastError(1);
            return "";
        }

        const io = processIo();
        const alloc = std.heap.page_allocator;

        const cmd_argv = if (builtin.os.tag == .windows)
            [_][]const u8{ "cmd", "/C", input }
        else
            [_][]const u8{ "sh", "-c", input };

        var cmd = std.process.spawn(io, .{
            .argv = &cmd_argv,
            .stdout = .pipe,
            .stderr = .pipe,
        }) catch |err| {
            setLastError(mapProcessSpawn(@errorName(err)));
            return "";
        };
        defer cmd.kill(io);

        var multi_reader_buffer: std.Io.File.MultiReader.Buffer(2) = undefined;
        var multi_reader: std.Io.File.MultiReader = undefined;
        multi_reader.init(alloc, io, multi_reader_buffer.toStreams(), &.{ cmd.stdout.?, cmd.stderr.? });
        defer multi_reader.deinit();

        while (multi_reader.fill(64, .none)) |_| {} else |err| switch (err) {
            error.EndOfStream => {},
            else => {
                setLastError(205);
                return "";
            },
        }
        multi_reader.checkAnyError() catch {
            setLastError(205);
            return "";
        };

        const stdout_owned = multi_reader.toOwnedSlice(0) catch {
            setLastError(205);
            return "";
        };
        defer alloc.free(stdout_owned);

        const term = cmd.wait(io) catch |err| {
            setLastError(mapProcessWait(@errorName(err)));
            return "";
        };

        switch (term) {
            .exited => |code| {
                if (code != 0) {
                    setLastError(207);
                    return "";
                }
            },
            else => {
                setLastError(208);
                return "";
            },
        }

        const duped = alloc.dupe(u8, stdout_owned) catch |err| {
            const mc = mapCommon(@errorName(err));
            if (mc >= 0) {
                setLastError(mc);
                return "";
            }
            setLastError(205);
            return "";
        };

        return duped;
    }

    pub fn osName() []const u8 {
        return @tagName(builtin.os.tag);
    }

    pub fn argCount() i64 {
        clearLastError();
        return doxa_argc();
    }

    pub fn argAt(index_text: []const u8) []const u8 {
        clearLastError();

        const index = std.fmt.parseInt(i64, index_text, 10) catch {
            setLastError(1);
            return "";
        };
        if (index < 0) {
            setLastError(1);
            return "";
        }

        if (index >= doxa_argc()) {
            setLastError(1);
            return "";
        }

        const arg_ptr = doxa_argv(@intCast(index)) orelse {
            setLastError(1);
            return "";
        };

        const duped = std.heap.page_allocator.dupe(u8, std.mem.span(arg_ptr)) catch |err| {
            const mc = mapCommon(@errorName(err));
            if (mc >= 0) {
                setLastError(mc);
                return "";
            }
            setLastError(208);
            return "";
        };

        return duped;
    }

    pub fn exitCode(code_text: []const u8) void {
        const code = std.fmt.parseInt(i64, code_text, 10) catch 1;
        std.process.exit(@intCast(code));
    }

    pub fn cwd() []const u8 {
        clearLastError();
        const io = processIo();
        const content = std.process.currentPathAlloc(io, std.heap.page_allocator) catch |err| {
            const mc = mapCommon(@errorName(err));
            if (mc >= 0) {
                setLastError(mc);
                return "";
            }
            setLastError(208);
            return "";
        };
        return content;
    }

    pub fn getEnv(name: []const u8) []const u8 {
        clearLastError();
        if (name.len == 0) {
            setLastError(1);
            return "";
        }

        var value_len: u64 = 0;
        const value_ptr = doxa_getenv(name.ptr, name.len, &value_len) orelse {
            setLastError(208);
            return "";
        };

        const content = std.heap.page_allocator.dupe(u8, value_ptr[0..@intCast(value_len)]) catch |err| {
            const mc = mapCommon(@errorName(err));
            if (mc >= 0) {
                setLastError(mc);
                return "";
            }
            setLastError(208);
            return "";
        };
        return content;
    }
}

function mapProcessError(code :: int) returns error.StdError {
    return match code {
        1 then error.Common.InvalidArgument,
        2 then error.Common.OutOfMemory,
        3 then error.Common.PermissionDenied,
        4 then error.Common.NotSupported,
        5 then error.Common.Unexpected,
        200 then error.Process.CommandNotFound,
        201 then error.Process.NotExecutable,
        202 then error.Process.SpawnFailed,
        203 then error.Process.WaitFailed,
        204 then error.Process.KillFailed,
        205 then error.Process.CaptureFailed,
        206 then error.Process.OutputTooLarge,
        207 then error.Process.NonZeroExit,
        208 then error.Process.Unexpected,
        else error.Common.Unexpected,
    }
}

public function exec(input :: string) returns int | error.StdError {
    var input_string :: string
    if Process.osName() == "windows" then {
        each c in input {
            if c == "/" then {
                @push(input_string, "\\")
            } else {
                @push(input_string, c)
            }
        }
    } else {
        input_string is input
    }

    const code is Process.exec_cmd(input_string)
    const err is Process.takeLastErrorCode()
    if err == 0 then return code
    return mapProcessError(err)
}

public function execCapture(input :: string) returns string | error.StdError {
    var input_string :: string
    if Process.osName() == "windows" then {
        each c in input {
            if c == "/" then {
                @push(input_string, "\\")
            } else {
                @push(input_string, c)
            }
        }
    } else {
        input_string is input
    }

    const output is Process.exec_capture_stdout(input_string)
    const err is Process.takeLastErrorCode()
    if err == 0 then return output
    return mapProcessError(err)
}

public function execOk(input :: string) returns tetra {
    const result is exec(input)
    result as int then {
        return true
    }
    else {
        return false
    }
}

public function args() returns string[] | error.StdError {
    const _argc is argc() as int else {
        return mapProcessError(Process.takeLastErrorCode())
    }
    var result :: string[]
    for i while i < _argc do i += 1 {
        const arg is argv(i) as string else {
            return mapProcessError(Process.takeLastErrorCode())
        }
        @push(result, arg)
    }
    const err is Process.takeLastErrorCode()
    if err == 0 then return result
    return mapProcessError(err)
}

public function argc() returns int | error.StdError {
    const count is Process.argCount();
    const err is Process.takeLastErrorCode()
    if err == 0 then return count
    return mapProcessError(err)
}

public function argv(index :: int) returns string | error.StdError {
    const value is Process.argAt(@string(index));
    const err is Process.takeLastErrorCode()
    if err == 0 then return value
    return mapProcessError(err)
}

public function exit(code :: int) {
    Process.exitCode(@string(code));
}

public function cwd() returns string | error.StdError {
    const value is Process.cwd();
    const err is Process.takeLastErrorCode()
    if err == 0 then return value
    return mapProcessError(err)
}

public function getenv(name :: string) returns string | error.StdError {
    const value is Process.getEnv(name);
    const err is Process.takeLastErrorCode()
    if err == 0 then return value
    return mapProcessError(err)
}
