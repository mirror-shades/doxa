module zerr from "../zerr/zerr.doxa"

zig JSON {
    const std = @import("std");

    fn frameRecord() type {
        return struct {
            in_object: bool = false,
            expect_value: bool = false,
            items: i64 = 0,
        };
    }

    fn nodeRecord() type {
        return struct {
            kind: u8 = 0,
            int_value: i64 = 0,
            float_value: f64 = 0,
            bool_value: bool = false,
            text_value: []const u8 = "",
            key: []const u8 = "",
            has_key: bool = false,
            child_start: i64 = -1,
            child_count: i64 = 0,
        };
    }

    fn writerStateType() type {
        return struct {
            var buffer: std.ArrayList(u8) = .empty;
            var stack: std.ArrayList(frameRecord()) = .empty;
            var root_written = false;
            var failure: ?@"DoxaError_zerr.ZigError" = null;
            var finished = false;
        };
    }

    fn domStateType() type {
        return struct {
            var generation: u32 = 1;
            var nodes: std.ArrayList(nodeRecord()) = .empty;
            var parsed: ?std.json.Parsed(std.json.Value) = null;
        };
    }

    // The writer refuses what Zig's JSON parser would reject, by the name the
    // parser gives it: a write the grammar does not allow is `SyntaxError`, a
    // document finished unfinished `UnexpectedEndOfInput`. Text that is not
    // UTF-8 is `InvalidUtf8`.

    /// Only `finish` ends a document, on every path, so the first write after
    /// it starts the next one. The reset waits for that first write, so the
    /// text `finish` returned stays valid until the next document starts.
    fn ensureFresh() void {
        const w = writerStateType();
        if (!w.finished) return;
        w.buffer.clearRetainingCapacity();
        w.stack.clearRetainingCapacity();
        w.root_written = false;
        w.failure = null;
        w.finished = false;
    }

    /// The first refusal holds for the rest of its document: every later write
    /// in it, and its `finish`, return that refusal.
    fn write(result: @"DoxaError_zerr.ZigError"!void) @"DoxaError_zerr.ZigError"!void {
        try guard();
        result catch |err| {
            writerStateType().failure = err;
            return err;
        };
    }

    fn guard() @"DoxaError_zerr.ZigError"!void {
        if (writerStateType().failure) |err| return err;
    }

    fn appendSlice(s: []const u8) @"DoxaError_zerr.ZigError"!void {
        try writerStateType().buffer.appendSlice(std.heap.page_allocator, s);
    }

    fn appendNumber(comptime fmt: []const u8, args: anytype) @"DoxaError_zerr.ZigError"!void {
        try writerStateType().buffer.print(std.heap.page_allocator, fmt, args);
    }

    // String escaping derived from Para (MIT), Copyright 2025 mirror-shades
    fn appendQuoted(bytes: []const u8) @"DoxaError_zerr.ZigError"!void {
        if (!std.unicode.utf8ValidateSlice(bytes)) return error.InvalidUtf8;
        try appendSlice("\"");
        for (bytes) |c| {
            switch (c) {
                '"' => try appendSlice("\\\""),
                '\\' => try appendSlice("\\\\"),
                0x08 => try appendSlice("\\b"),
                0x0C => try appendSlice("\\f"),
                '\n' => try appendSlice("\\n"),
                '\r' => try appendSlice("\\r"),
                '\t' => try appendSlice("\\t"),
                else => {
                    if (c < 0x20) {
                        const hex = "0123456789abcdef";
                        try appendSlice("\\u00");
                        try appendSlice(&.{ hex[c >> 4], hex[c & 0x0F] });
                    } else {
                        try appendSlice(&.{c});
                    }
                },
            }
        }
        try appendSlice("\"");
    }

    fn beforeValue() @"DoxaError_zerr.ZigError"!void {
        const w = writerStateType();
        if (w.stack.items.len > 0) {
            const top = &w.stack.items[w.stack.items.len - 1];
            if (top.in_object) {
                if (!top.expect_value) return error.SyntaxError;
                top.expect_value = false;
            } else if (top.items > 0) {
                try appendSlice(",");
            }
            top.items += 1;
        } else {
            if (w.root_written) return error.SyntaxError;
            w.root_written = true;
        }
    }

    fn open(in_object: bool) @"DoxaError_zerr.ZigError"!void {
        try beforeValue();
        try appendSlice(if (in_object) "{" else "[");
        try writerStateType().stack.append(std.heap.page_allocator, .{ .in_object = in_object });
    }

    fn key(name: []const u8) @"DoxaError_zerr.ZigError"!void {
        const w = writerStateType();
        if (w.stack.items.len == 0) return error.SyntaxError;
        const top = &w.stack.items[w.stack.items.len - 1];
        if (!top.in_object or top.expect_value) return error.SyntaxError;
        if (top.items > 0) try appendSlice(",");
        try appendQuoted(name);
        try appendSlice(":");
        top.expect_value = true;
    }

    fn text(value: []const u8) @"DoxaError_zerr.ZigError"!void {
        try beforeValue();
        try appendQuoted(value);
    }

    fn int(value: i64) @"DoxaError_zerr.ZigError"!void {
        try beforeValue();
        try appendNumber("{d}", .{value});
    }

    // JSON has no NaN or infinity.
    fn float(value: f64) @"DoxaError_zerr.ZigError"!void {
        if (std.math.isNan(value) or std.math.isInf(value)) return error.SyntaxError;
        try beforeValue();
        try appendNumber("{d}", .{value});
    }

    fn literal(word: []const u8) @"DoxaError_zerr.ZigError"!void {
        try beforeValue();
        try appendSlice(word);
    }

    fn close() @"DoxaError_zerr.ZigError"!void {
        const w = writerStateType();
        if (w.stack.items.len == 0) return error.SyntaxError;
        const top = w.stack.items[w.stack.items.len - 1];
        if (top.in_object and top.expect_value) return error.SyntaxError;
        _ = w.stack.pop();
        try appendSlice(if (top.in_object) "}" else "]");
    }

    fn complete() @"DoxaError_zerr.ZigError"!void {
        const w = writerStateType();
        if (w.stack.items.len != 0 or !w.root_written) return error.UnexpectedEndOfInput;
    }

    pub fn writerBeginObject() @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(open(true));
    }

    pub fn writerBeginArray() @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(open(false));
    }

    pub fn writerKey(name: []const u8) @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(key(name));
    }

    pub fn writerText(value: []const u8) @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(text(value));
    }

    pub fn writerInt(value: i64) @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(int(value));
    }

    pub fn writerFloat(value: f64) @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(float(value));
    }

    pub fn writerBoolean(value: bool) @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(literal(if (value) "true" else "false"));
    }

    pub fn writerNull() @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(literal("null"));
    }

    // A value Doxa can hold but JSON cannot write (a tetra's `both` or
    // `neither`).
    pub fn writerRefuse() @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        return write(error.SyntaxError);
    }

    pub fn writerEnd() @"DoxaError_zerr.ZigError"!void {
        ensureFresh();
        try guard();
        return write(close());
    }

    pub fn writerFinish() @"DoxaError_zerr.ZigError"![]const u8 {
        ensureFresh();
        const w = writerStateType();
        defer w.finished = true;
        try write(complete());
        return w.buffer.items;
    }

    fn packHandle(index: usize) i64 {
        const gen: u64 = domStateType().generation;
        return @bitCast((gen << 32) | @as(u64, index));
    }

    /// The node a handle names, or null for 0 (no node) and for a handle into
    /// an earlier document.
    fn resolveNode(handle: i64) ?nodeRecord() {
        if (handle == 0) return null;
        const state = domStateType();
        const raw: u64 = @bitCast(handle);
        const gen: u32 = @truncate(raw >> 32);
        if (gen != state.generation) return null;
        const idx: usize = @as(u32, @truncate(raw));
        if (idx >= state.nodes.items.len) return null;
        return state.nodes.items[idx];
    }

    fn makeNode(value: std.json.Value, name: []const u8, has_key: bool) nodeRecord() {
        var node = nodeRecord(){
            .key = name,
            .has_key = has_key,
            .child_start = -1,
            .child_count = 0,
        };
        switch (value) {
            .null => node.kind = 1,
            .bool => |b| {
                node.kind = 2;
                node.bool_value = b;
            },
            .integer => |i| {
                node.kind = 3;
                node.int_value = i;
            },
            .float => |f| {
                node.kind = 4;
                node.float_value = f;
            },
            .number_string => |s| {
                node.kind = 4;
                node.float_value = std.fmt.parseFloat(f64, s) catch std.math.inf(f64);
            },
            .string => |s| {
                node.kind = 5;
                node.text_value = s;
            },
            .array, .object => node.kind = if (value == .array) 6 else 7,
        }
        return node;
    }

    // A handle packs a node's index into 32 bits.
    fn addNode(node: nodeRecord()) @"DoxaError_zerr.ZigError"!usize {
        const state = domStateType();
        if (state.nodes.items.len > std.math.maxInt(u32)) return error.Overflow;
        try state.nodes.append(std.heap.page_allocator, node);
        return state.nodes.items.len - 1;
    }

    fn buildDocument(root: std.json.Value) @"DoxaError_zerr.ZigError"!void {
        const Work = struct {
            node_index: usize,
            value: std.json.Value,
        };

        const state = domStateType();
        const allocator = std.heap.page_allocator;

        var work: std.ArrayList(Work) = .empty;
        defer work.deinit(allocator);

        try work.append(allocator, .{ .node_index = try addNode(makeNode(root, "", false)), .value = root });

        while (work.pop()) |item| {
            const value = item.value;
            if (value != .array and value != .object) continue;

            const first: i64 = @intCast(state.nodes.items.len);
            var count: i64 = 0;

            if (value == .array) {
                for (value.array.items) |child_value| {
                    const idx = try addNode(makeNode(child_value, "", false));
                    try work.append(allocator, .{ .node_index = idx, .value = child_value });
                    count += 1;
                }
            } else {
                for (value.object.keys(), value.object.values()) |name, child_value| {
                    const idx = try addNode(makeNode(child_value, name, true));
                    try work.append(allocator, .{ .node_index = idx, .value = child_value });
                    count += 1;
                }
            }

            const parent = &state.nodes.items[item.node_index];
            parent.child_start = first;
            parent.child_count = count;
        }
    }

    pub fn parseDocument(source: []const u8) @"DoxaError_zerr.ZigError"!i64 {
        const parsed = try std.json.parseFromSlice(std.json.Value, std.heap.page_allocator, source, .{
            .allocate = .alloc_always,
        });

        const state = domStateType();
        state.generation +%= 1;
        if (state.generation == 0) state.generation = 1;
        if (state.parsed) |*old| old.deinit();
        state.parsed = parsed;
        state.nodes.clearRetainingCapacity();

        try buildDocument(state.parsed.?.value);
        return packHandle(0);
    }

    /// 0 for a handle that names no node; the `Kind` discriminant otherwise.
    pub fn nodeKind(handle: i64) i64 {
        const node = resolveNode(handle) orelse return 0;
        return node.kind;
    }

    // The node readers below assume the caller checked `nodeKind`; a handle
    // that names no node, or the wrong kind, reads as empty.

    pub fn nodeCount(handle: i64) i64 {
        const node = resolveNode(handle) orelse return 0;
        return node.child_count;
    }

    /// The handle of child `index`, or 0 when there is none.
    pub fn nodeChild(handle: i64, index: i64) i64 {
        const node = resolveNode(handle) orelse return 0;
        if (node.kind != 6 and node.kind != 7) return 0;
        if (index < 0 or index >= node.child_count) return 0;
        return packHandle(@intCast(node.child_start + index));
    }

    /// The handle of the field called `name`, or 0 when there is none.
    pub fn nodeField(handle: i64, name: []const u8) i64 {
        const node = resolveNode(handle) orelse return 0;
        if (node.kind != 7) return 0;
        const children = domStateType().nodes.items;
        var i: i64 = 0;
        while (i < node.child_count) : (i += 1) {
            const at: usize = @intCast(node.child_start + i);
            if (std.mem.eql(u8, children[at].key, name)) return packHandle(at);
        }
        return 0;
    }

    pub fn nodeHasKey(handle: i64) bool {
        const node = resolveNode(handle) orelse return false;
        return node.has_key;
    }

    pub fn nodeKey(handle: i64) []const u8 {
        const node = resolveNode(handle) orelse return "";
        return node.key;
    }

    pub fn nodeText(handle: i64) []const u8 {
        const node = resolveNode(handle) orelse return "";
        return node.text_value;
    }

    pub fn nodeIntValue(handle: i64) i64 {
        const node = resolveNode(handle) orelse return 0;
        return node.int_value;
    }

    pub fn nodeFloatValue(handle: i64) f64 {
        const node = resolveNode(handle) orelse return 0;
        return node.float_value;
    }

    pub fn nodeBooleanValue(handle: i64) bool {
        const node = resolveNode(handle) orelse return false;
        return node.bool_value;
    }
}

public enum Kind {
    Invalid,
    Null,
    Boolean,
    Integer,
    Number,
    Text,
    Array,
    Object,
}

public struct Node {
    handle :: int,

    function new(h :: int) returns Node {
        return $Node {
            handle is h
        }
    }

    # Parse `text` as one JSON document. A node of an earlier document reads
    # as `Kind.Invalid` once another is parsed.
    public function parse(text :: string) returns Node | zerr.ZigError {
        const root is JSON.parseDocument(text) as int else {
            return root
        }
        return Node.new(root)
    }

    public method kind() returns Kind {
        const code is JSON.nodeKind(this.handle)
        return match code {
            1 then Kind.Null,
            2 then Kind.Boolean,
            3 then Kind.Integer,
            4 then Kind.Number,
            5 then Kind.Text,
            6 then Kind.Array,
            7 then Kind.Object,
            else Kind.Invalid,
        }
    }

    method holds(kind :: Kind) returns tetra {
        return this.kind() == kind
    }

    # How many elements or fields, or `nothing` for a node that is neither an
    # array nor an object.
    public method count() returns int | nothing {
        if not this.holds(Kind.Array) and not this.holds(Kind.Object) then return nothing
        return JSON.nodeCount(this.handle)
    }

    public method element(index :: int) returns Node | nothing {
        const child is JSON.nodeChild(this.handle, index)
        if child == 0 then return nothing
        return Node.new(child)
    }

    public method field(name :: string) returns Node | nothing {
        const child is JSON.nodeField(this.handle, name)
        if child == 0 then return nothing
        return Node.new(child)
    }

    # The field name this node is stored under, or `nothing` for a node that
    # is not an object's field.
    public method key() returns string | nothing {
        if not JSON.nodeHasKey(this.handle) then return nothing
        return JSON.nodeKey(this.handle)
    }

    public method text() returns string | nothing {
        if not this.holds(Kind.Text) then return nothing
        return JSON.nodeText(this.handle)
    }

    public method intValue() returns int | nothing {
        if not this.holds(Kind.Integer) then return nothing
        return JSON.nodeIntValue(this.handle)
    }

    public method floatValue() returns float | nothing {
        if not this.holds(Kind.Number) then return nothing
        return JSON.nodeFloatValue(this.handle)
    }

    public method booleanValue() returns tetra | nothing {
        if not this.holds(Kind.Boolean) then return nothing
        return JSON.nodeBooleanValue(this.handle)
    }
}

public function beginObject() returns nothing | zerr.ZigError {
    return JSON.writerBeginObject()
}

public function beginArray() returns nothing | zerr.ZigError {
    return JSON.writerBeginArray()
}

public function end() returns nothing | zerr.ZigError {
    return JSON.writerEnd()
}

public function writeKey(name :: string) returns nothing | zerr.ZigError {
    return JSON.writerKey(name)
}

public function writeText(text :: string) returns nothing | zerr.ZigError {
    return JSON.writerText(text)
}

public function writeInt(value :: int) returns nothing | zerr.ZigError {
    return JSON.writerInt(value)
}

public function writeFloat(value :: float) returns nothing | zerr.ZigError {
    return JSON.writerFloat(value)
}

public function writeBoolean(value :: tetra) returns nothing | zerr.ZigError {
    if value == both or value == neither then return JSON.writerRefuse()
    return JSON.writerBoolean(value == true)
}

public function writeNull() returns nothing | zerr.ZigError {
    return JSON.writerNull()
}

# End the document: its text, or the first refusal it met. The next write
# starts a new document either way.
public function finish() returns string | zerr.ZigError {
    return JSON.writerFinish()
}
