module error from "../error.doxa"

zig File {
    const std = @import("std");

    fn io() std.Io {
        return std.Io.Threaded.global_single_threaded.io();
    }

    /// Map a std filesystem error to the `error.IO` variant the Doxa side
    /// carries. A fallible function below returns `@"DoxaError_error.IO"`, whose
    /// error set the wrapper synthesizes from `error.IO`'s variants, so every
    /// `error.<Variant>` named here is a real IO variant. `err` is `anyerror`, so
    /// any libc/std error name can be matched.
    fn ioError(err: anyerror) @"DoxaError_error.IO" {
        return switch (err) {
            error.PathAlreadyExists => error.AlreadyExists,
            error.NotDir => error.NotDirectory,
            error.IsDir => error.IsDirectory,
            error.FileNotFound => error.NotFound,
            error.BadPathName, error.NameTooLong, error.InvalidFileName, error.InvalidUtf8 => error.InvalidPath,
            error.AccessDenied, error.PermissionDenied, error.ReadOnlyFileSystem => error.Unexpected,
            error.NoSpaceLeft, error.DiskQuota, error.SystemResources, error.OutOfMemory => error.WriteFailed,
            error.InputOutput, error.Unexpected => error.Unexpected,
            else => error.Unexpected,
        };
    }

    pub fn makeDir(path: []const u8) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;
        std.Io.Dir.cwd().createDir(io(), path, .default_dir) catch |err| return ioError(err);
    }

    pub fn makePath(path: []const u8) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;
        std.Io.Dir.cwd().createDirPath(io(), path) catch |err| return ioError(err);
    }

    pub fn copyFile(source: []const u8, destination: []const u8) @"DoxaError_error.IO"!void {
        if (source.len == 0 or destination.len == 0) return error.InvalidPath;
        const _cwd = std.Io.Dir.cwd();
        std.Io.Dir.copyFile(_cwd, source, _cwd, destination, io(), .{}) catch |err| return ioError(err);
    }

    pub fn delete(path: []const u8, recursive: bool) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;

        const _cwd = std.Io.Dir.cwd();
        _cwd.deleteFile(io(), path) catch |err| {
            if (err == error.IsDir) {
                if (recursive) {
                    _cwd.deleteTree(io(), path) catch |e| return ioError(e);
                } else {
                    _cwd.deleteDir(io(), path) catch |e| return ioError(e);
                }
                return;
            }
            return ioError(err);
        };
    }

    pub fn copyDir(source: []const u8, destination: []const u8) @"DoxaError_error.IO"!void {
        if (source.len == 0 or destination.len == 0) return error.InvalidPath;

        const allocator = std.heap.page_allocator;
        const Task = struct {
            src: []u8,
            dst: []u8,
        };

        var stack = std.array_list.Managed(Task).init(allocator);
        defer {
            for (stack.items) |item| {
                allocator.free(item.src);
                allocator.free(item.dst);
            }
            stack.deinit();
        }

        const root_src = allocator.dupe(u8, source) catch |err| return ioError(err);
        const root_dst = allocator.dupe(u8, destination) catch |err| {
            allocator.free(root_src);
            return ioError(err);
        };
        stack.append(.{ .src = root_src, .dst = root_dst }) catch |err| {
            allocator.free(root_src);
            allocator.free(root_dst);
            return ioError(err);
        };

        while (stack.items.len != 0) {
            const task = stack.pop().?;
            defer allocator.free(task.src);
            defer allocator.free(task.dst);

            var src_dir = std.Io.Dir.cwd().openDir(io(), task.src, .{ .iterate = true }) catch |err| return ioError(err);
            defer src_dir.close(io());

            std.Io.Dir.cwd().createDirPath(io(), task.dst) catch |err| return ioError(err);

            var dst_dir = std.Io.Dir.cwd().openDir(io(), task.dst, .{ .iterate = true }) catch |err| return ioError(err);
            defer dst_dir.close(io());

            var iter = src_dir.iterate();
            while (true) {
                const next_entry = iter.next(io()) catch |err| return ioError(err);
                const entry = next_entry orelse break;
                const name = entry.name;
                if (name[0] == '.' and (name.len == 1 or (name.len == 2 and name[1] == '.'))) continue;

                switch (entry.kind) {
                    .file => {
                        const src_file_path = std.fmt.allocPrint(allocator, "{s}{s}{s}", .{ task.src, std.fs.path.sep_str, name }) catch |err| return ioError(err);
                        defer allocator.free(src_file_path);

                        std.Io.Dir.copyFile(std.Io.Dir.cwd(), src_file_path, dst_dir, name, io(), .{}) catch |err| return ioError(err);
                    },
                    .directory => {
                        const sub_src = std.fmt.allocPrint(allocator, "{s}{s}{s}", .{ task.src, std.fs.path.sep_str, name }) catch |err| return ioError(err);
                        const sub_dst = std.fmt.allocPrint(allocator, "{s}{s}{s}", .{ task.dst, std.fs.path.sep_str, name }) catch |err| {
                            allocator.free(sub_src);
                            return ioError(err);
                        };
                        stack.append(.{ .src = sub_src, .dst = sub_dst }) catch |err| {
                            allocator.free(sub_src);
                            allocator.free(sub_dst);
                            return ioError(err);
                        };
                    },
                    else => {},
                }
            }
        }
    }

    pub fn unzipFile(zip_path: []const u8, out_dir_path: []const u8) @"DoxaError_error.IO"!void {
        if (zip_path.len == 0 or out_dir_path.len == 0) return error.InvalidPath;

        const _cwd = std.Io.Dir.cwd();

        _cwd.createDirPath(io(), out_dir_path) catch |err| return ioError(err);

        var out_dir = _cwd.openDir(io(), out_dir_path, .{}) catch |err| return ioError(err);
        defer out_dir.close(io());

        var zip_file = _cwd.openFile(io(), zip_path, .{}) catch |err| return ioError(err);
        defer zip_file.close(io());

        var buf: [std.compress.flate.max_window_len]u8 = undefined;
        var r = zip_file.reader(io(), &buf);

        std.zip.extract(out_dir, &r, .{}) catch |err| return ioError(err);
    }

    pub fn IsDir(path: []const u8) bool {
        var dir = std.Io.Dir.cwd().openDir(io(), path, .{}) catch {
            return false;
        };
        dir.close(io());
        return true;
    }

    pub fn renameDir(old_folder: []const u8, new_folder: []const u8) @"DoxaError_error.IO"!void {
        if (old_folder.len == 0 or new_folder.len == 0) return error.InvalidPath;
        const _cwd = std.Io.Dir.cwd();
        std.Io.Dir.rename(_cwd, old_folder, _cwd, new_folder, io()) catch |err| return ioError(err);
    }

    pub fn rename(old_path: []const u8, new_path: []const u8) @"DoxaError_error.IO"!void {
        if (old_path.len == 0 or new_path.len == 0) return error.InvalidPath;
        const _cwd = std.Io.Dir.cwd();
        std.Io.Dir.rename(_cwd, old_path, _cwd, new_path, io()) catch |err| return ioError(err);
    }

    pub fn read(path: []const u8) @"DoxaError_error.IO"![]const u8 {
        if (path.len == 0) return error.InvalidPath;

        const _cwd = std.Io.Dir.cwd();
        const file = _cwd.openFile(io(), path, .{}) catch |err| return ioError(err);
        defer file.close(io());

        var read_buf: [4096]u8 = undefined;
        var file_reader = file.reader(io(), &read_buf);
        const content = file_reader.interface.allocRemaining(std.heap.page_allocator, .unlimited) catch |err| return ioError(err);

        // The wrapper clones `content` into the call-site arena before this
        // returns; a single retained slot keeps the backing store bounded
        // without a free hook for foreign heap shapes.
        const State = struct {
            var cache: ?[]u8 = null;
        };
        if (State.cache) |prev| {
            std.heap.page_allocator.free(prev);
        }
        State.cache = content;
        return content;
    }

    pub fn write(path: []const u8, content: []const u8) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;
        const _cwd = std.Io.Dir.cwd();
        _cwd.writeFile(io(), .{
            .sub_path = path,
            .data = content,
        }) catch |err| return ioError(err);
    }

    pub fn append(path: []const u8, content: []const u8) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;

        const _cwd = std.Io.Dir.cwd();
        var file = _cwd.createFile(io(), path, .{
            .read = true,
            .truncate = false,
        }) catch |err| return ioError(err);
        defer file.close(io());

        const size = file.length(io()) catch |err| return ioError(err);
        file.writePositionalAll(io(), content, size) catch |err| return ioError(err);
    }

    pub fn exists(path: []const u8) bool {
        std.Io.Dir.cwd().access(io(), path, .{}) catch return false;
        return true;
    }

    pub fn isFile(path: []const u8) bool {
        const file = std.Io.Dir.cwd().openFile(io(), path, .{}) catch return false;
        file.close(io());
        return true;
    }

    pub fn list(path: []const u8) @"DoxaError_error.IO"![]const []const u8 {
        if (path.len == 0) return error.InvalidPath;

        // The returned slice is borrowed by the inline-Zig wrapper, which copies
        // every name into the call-site arena before returning, so the backing
        // store only has to outlive this call. A retained process-lifetime arena
        // re-used across calls keeps that bounded without a free hook (the ABI
        // has none for foreign heap shapes).
        const State = struct {
            var arena: std.heap.ArenaAllocator = std.heap.ArenaAllocator.init(std.heap.page_allocator);
        };
        _ = State.arena.reset(.retain_capacity);

        var out = std.array_list.Managed([]const u8).init(State.arena.allocator());

        var dir = std.Io.Dir.cwd().openDir(io(), path, .{ .iterate = true }) catch |err| return ioError(err);
        defer dir.close(io());

        var it = dir.iterate();
        while (true) {
            const next_entry = it.next(io()) catch |err| return ioError(err);
            const entry = next_entry orelse break;
            if (std.mem.eql(u8, entry.name, ".") or std.mem.eql(u8, entry.name, "..")) continue;
            const name = State.arena.allocator().dupe(u8, entry.name) catch return error.Unexpected;
            out.append(name) catch return error.Unexpected;
        }

        return out.toOwnedSlice() catch return error.Unexpected;
    }

    pub fn touch(path: []const u8) @"DoxaError_error.IO"!void {
        if (path.len == 0) return error.InvalidPath;
        const file = std.Io.Dir.cwd().createFile(io(), path, .{
            .truncate = false,
        }) catch |err| return ioError(err);
        file.close(io());
    }
}

public function makeDir(path :: string) returns nothing | error.StdError {
    return File.makeDir(path)
}

public function makePath(path :: string) returns nothing | error.StdError {
    return File.makePath(path)
}

public function copyFile(source :: string, destination :: string) returns nothing | error.StdError {
    return File.copyFile(source, destination)
}

public function delete(path :: string, recursive :: tetra) returns nothing | error.StdError {
    return File.delete(path, recursive)
}

public function copyDir(source :: string, destination :: string) returns nothing | error.StdError {
    return File.copyDir(source, destination)
}

public function unzipFile(zip_path :: string, unzip_path :: string) returns nothing | error.StdError {
    return File.unzipFile(zip_path, unzip_path)
}

public function isDir(path :: string) returns tetra {
    return File.IsDir(path)
}

public function renameDir(old_folder :: string, new_folder :: string) returns nothing | error.StdError {
    return File.renameDir(old_folder, new_folder)
}

public function rename(old_path :: string, new_path :: string) returns nothing | error.StdError {
    return File.rename(old_path, new_path)
}

public function read(path :: string) returns string | error.StdError {
    return File.read(path)
}

public function write(path :: string, content :: string) returns nothing | error.StdError {
    return File.write(path, content)
}

public function append(path :: string, content :: string) returns nothing | error.StdError {
    return File.append(path, content)
}

public function exists(path :: string) returns tetra {
    return File.exists(path)
}

public function isFile(path :: string) returns tetra {
    return File.isFile(path)
}

public function list(path :: string) returns string[] | error.StdError {
    return File.list(path)
}

public function touch(path :: string) returns nothing | error.StdError {
    return File.touch(path)
}
