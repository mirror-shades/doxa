module zerr from "../zerr/zerr.doxa"

zig File {
    const std = @import("std");

    fn io() std.Io {
        return std.Io.Threaded.global_single_threaded.io();
    }

    // Memory for one call, reset when the next call begins. The wrapper copies
    // every returned string and array into the caller's arena before
    // returning, so nothing here outlives the call that made it.
    fn scratch() std.mem.Allocator {
        const State = struct {
            var arena: std.heap.ArenaAllocator = .init(std.heap.page_allocator);
        };
        _ = State.arena.reset(.{ .retain_with_limit = 64 * 1024 });
        return State.arena.allocator();
    }

    // Zig asserts on an empty path in some calls; report it as the path Zig
    // cannot use.
    fn checkPath(path: []const u8) @"DoxaError_zerr.ZigError"!void {
        if (path.len == 0) return error.BadPathName;
    }

    pub fn makeDir(path: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        try std.Io.Dir.cwd().createDir(io(), path, .default_dir);
    }

    pub fn makePath(path: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        try std.Io.Dir.cwd().createDirPath(io(), path);
    }

    pub fn copyFile(source: []const u8, destination: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(source);
        try checkPath(destination);
        const cwd = std.Io.Dir.cwd();
        try std.Io.Dir.copyFile(cwd, source, cwd, destination, io(), .{});
    }

    pub fn delete(path: []const u8, recursive: bool) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        const cwd = std.Io.Dir.cwd();
        cwd.deleteFile(io(), path) catch |err| switch (err) {
            error.IsDir => if (recursive) try cwd.deleteTree(io(), path) else try cwd.deleteDir(io(), path),
            else => |e| return e,
        };
    }

    pub fn copyDir(source: []const u8, destination: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(source);
        try checkPath(destination);
        const alloc = scratch();
        const Task = struct {
            src: []const u8,
            dst: []const u8,
        };
        var stack: std.ArrayList(Task) = .empty;
        try stack.append(alloc, .{ .src = source, .dst = destination });

        const cwd = std.Io.Dir.cwd();
        while (stack.pop()) |task| {
            var src_dir = try cwd.openDir(io(), task.src, .{ .iterate = true });
            defer src_dir.close(io());

            try cwd.createDirPath(io(), task.dst);
            var dst_dir = try cwd.openDir(io(), task.dst, .{});
            defer dst_dir.close(io());

            var iter = src_dir.iterate();
            while (try iter.next(io())) |entry| {
                const name = entry.name;
                if (std.mem.eql(u8, name, ".") or std.mem.eql(u8, name, "..")) continue;
                switch (entry.kind) {
                    .file => try std.Io.Dir.copyFile(src_dir, name, dst_dir, name, io(), .{}),
                    .directory => try stack.append(alloc, .{
                        .src = try std.fs.path.join(alloc, &.{ task.src, name }),
                        .dst = try std.fs.path.join(alloc, &.{ task.dst, name }),
                    }),
                    else => {},
                }
            }
        }
    }

    pub fn unzipFile(zip_path: []const u8, out_dir_path: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(zip_path);
        try checkPath(out_dir_path);
        const cwd = std.Io.Dir.cwd();

        try cwd.createDirPath(io(), out_dir_path);
        var out_dir = try cwd.openDir(io(), out_dir_path, .{});
        defer out_dir.close(io());

        var zip_file = try cwd.openFile(io(), zip_path, .{});
        defer zip_file.close(io());

        var buf: [std.compress.flate.max_window_len]u8 = undefined;
        var r = zip_file.reader(io(), &buf);
        try std.zip.extract(out_dir, &r, .{});
    }

    pub fn isDir(path: []const u8) bool {
        var dir = std.Io.Dir.cwd().openDir(io(), path, .{}) catch return false;
        dir.close(io());
        return true;
    }

    pub fn rename(old_path: []const u8, new_path: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(old_path);
        try checkPath(new_path);
        const cwd = std.Io.Dir.cwd();
        try std.Io.Dir.rename(cwd, old_path, cwd, new_path, io());
    }

    pub fn read(path: []const u8) @"DoxaError_zerr.ZigError"![]const u8 {
        try checkPath(path);
        const file = try std.Io.Dir.cwd().openFile(io(), path, .{});
        defer file.close(io());
        var read_buf: [4096]u8 = undefined;
        var file_reader = file.reader(io(), &read_buf);
        return file_reader.interface.allocRemaining(scratch(), .unlimited);
    }

    pub fn write(path: []const u8, content: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        try std.Io.Dir.cwd().writeFile(io(), .{ .sub_path = path, .data = content });
    }

    pub fn append(path: []const u8, content: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        var file = try std.Io.Dir.cwd().createFile(io(), path, .{ .read = true, .truncate = false });
        defer file.close(io());
        try file.writePositionalAll(io(), content, try file.length(io()));
    }

    pub fn isPresent(path: []const u8) bool {
        std.Io.Dir.cwd().access(io(), path, .{}) catch return false;
        return true;
    }

    pub fn isFile(path: []const u8) bool {
        const file = std.Io.Dir.cwd().openFile(io(), path, .{}) catch return false;
        file.close(io());
        return true;
    }

    pub fn list(path: []const u8) @"DoxaError_zerr.ZigError"![]const []const u8 {
        try checkPath(path);
        const alloc = scratch();
        var names: std.ArrayList([]const u8) = .empty;

        var dir = try std.Io.Dir.cwd().openDir(io(), path, .{ .iterate = true });
        defer dir.close(io());
        var it = dir.iterate();
        while (try it.next(io())) |entry| {
            if (std.mem.eql(u8, entry.name, ".") or std.mem.eql(u8, entry.name, "..")) continue;
            try names.append(alloc, try alloc.dupe(u8, entry.name));
        }
        return names.items;
    }

    pub fn touch(path: []const u8) @"DoxaError_zerr.ZigError"!void {
        try checkPath(path);
        const file = try std.Io.Dir.cwd().createFile(io(), path, .{ .truncate = false });
        file.close(io());
    }
}

public function makeDir(path :: string) returns nothing | zerr.ZigError {
    return File.makeDir(path)
}

public function makePath(path :: string) returns nothing | zerr.ZigError {
    return File.makePath(path)
}

public function copyFile(source :: string, destination :: string) returns nothing | zerr.ZigError {
    return File.copyFile(source, destination)
}

public function delete(path :: string, recursive :: tetra) returns nothing | zerr.ZigError {
    return File.delete(path, recursive)
}

public function copyDir(source :: string, destination :: string) returns nothing | zerr.ZigError {
    return File.copyDir(source, destination)
}

public function unzipFile(zip_path :: string, unzip_path :: string) returns nothing | zerr.ZigError {
    return File.unzipFile(zip_path, unzip_path)
}

public function isDir(path :: string) returns tetra {
    return File.isDir(path)
}

public function renameDir(old_folder :: string, new_folder :: string) returns nothing | zerr.ZigError {
    return File.rename(old_folder, new_folder)
}

public function rename(old_path :: string, new_path :: string) returns nothing | zerr.ZigError {
    return File.rename(old_path, new_path)
}

public function read(path :: string) returns string | zerr.ZigError {
    return File.read(path)
}

public function write(path :: string, content :: string) returns nothing | zerr.ZigError {
    return File.write(path, content)
}

public function append(path :: string, content :: string) returns nothing | zerr.ZigError {
    return File.append(path, content)
}

public function isPresent(path :: string) returns tetra {
    return File.isPresent(path)
}

public function isFile(path :: string) returns tetra {
    return File.isFile(path)
}

public function list(path :: string) returns string[] | zerr.ZigError {
    return File.list(path)
}

public function touch(path :: string) returns nothing | zerr.ZigError {
    return File.touch(path)
}
