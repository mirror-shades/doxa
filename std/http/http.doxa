module error from "../error.doxa"

zig HTTP {
    const std = @import("std");
    const builtin = @import("builtin");

    pub fn errorState(mode: i64, value: i64) i64 {
        const State = struct {
            var last_error_code: i64 = 0;
        };
        if (mode == 0) {
            State.last_error_code = value;
            return 0;
        }
        if (mode == 1) {
            return State.last_error_code;
        }
        if (mode == 2) {
            const code = State.last_error_code;
            State.last_error_code = 0;
            return code;
        }
        return 0;
    }

    pub fn clearLastError() void {
        _ = errorState(0, 0);
    }

    pub fn setLastError(code: i64) void {
        _ = errorState(0, code);
    }

    pub fn takeLastErrorCode() i64 {
        return errorState(2, 0);
    }

    fn httpIoStateType() type {
        return struct {
            var threaded: std.Io.Threaded = init: {
                var t = std.Io.Threaded.init_single_threaded;
                t.allocator = std.heap.page_allocator;
                break :init t;
            };
            var base_io: std.Io = undefined;
            var vtable: std.Io.VTable = undefined;
            var io: std.Io = undefined;
            var timeout: std.Io.Timeout = .none;
            var initialized = false;
        };
    }

    fn waitForReadable(socket_handle: std.Io.net.Socket.Handle) std.Io.net.Stream.Reader.Error!void {
        const timeout = httpIoStateType().timeout;
        const io = httpIoStateType().base_io;
        const duration = timeout.toDurationFromNow(io) orelse return;
        const ns = duration.raw.nanoseconds;
        if (ns <= 0) return error.Timeout;

        if (comptime builtin.os.tag == .windows) {
            // Threaded.netReadWindows uses raw AFD handles, not Winsock SOCKETs,
            // so WSAPoll cannot wait on them. Match the AFD_POLL_INFO ABI and
            // use the kernel's AFD.POLL timeout before the normal AFD receive.
            const PollHandle = extern struct {
                handle: std.os.windows.HANDLE,
                events: u32,
                status: std.os.windows.NTSTATUS,
            };
            const PollInfo = extern struct {
                timeout: i64,
                count: u32,
                exclusive: std.os.windows.BOOLEAN,
                padding: [3]u8,
                handles: [1]PollHandle,
            };
            const timeout_100ns: i64 = @intCast(@min(
                @max(1, @divTrunc(ns + 99, 100)),
                std.math.maxInt(i64),
            ));
            var poll_info: PollInfo = .{
                .timeout = -timeout_100ns,
                .count = 1,
                .exclusive = .FALSE,
                .padding = .{ 0, 0, 0 },
                .handles = .{.{
                    .handle = socket_handle,
                    .events = 0x0001 | 0x0008 | 0x0010 | 0x0020,
                    .status = .SUCCESS,
                }},
            };
            const poll_bytes = std.mem.asBytes(&poll_info);
            const result = io.operate(.{ .device_io_control = .{
                .file = .{ .handle = socket_handle, .flags = .{ .nonblocking = true } },
                .code = std.os.windows.IOCTL.AFD.POLL,
                .in = poll_bytes,
                .out = poll_bytes,
            } }) catch |err| return switch (err) {
                error.Canceled => error.Canceled,
            };
            if (result.device_io_control.u.Status == .TIMEOUT or poll_info.handles[0].events == 0) {
                return error.Timeout;
            }
            if (poll_info.handles[0].status == .CONNECTION_RESET) return error.ConnectionResetByPeer;
            if (result.device_io_control.u.Status != .SUCCESS) return error.Unexpected;
            return;
        }

        if (comptime builtin.os.tag == .wasi or builtin.os.tag == .uefi or builtin.os.tag == .freestanding) {
            return error.NetworkDown;
        }

        const timeout_ms: i32 = @intCast(@min(
            @divTrunc(ns + std.time.ns_per_ms - 1, std.time.ns_per_ms),
            std.math.maxInt(i32),
        ));
        var poll_fds = [_]std.posix.pollfd{.{
            .fd = socket_handle,
            .events = std.posix.POLL.IN,
            .revents = 0,
        }};
        const ready = std.posix.poll(&poll_fds, timeout_ms) catch |err| return switch (err) {
            error.SystemResources => error.SystemResources,
            else => error.Unexpected,
        };
        if (ready == 0) return error.Timeout;
    }

    fn timeoutNetRead(
        userdata: ?*anyopaque,
        socket_handle: std.Io.net.Socket.Handle,
        buffers: [][]u8,
    ) std.Io.net.Stream.Reader.Error!usize {
        if (httpIoStateType().timeout != .none) try waitForReadable(socket_handle);
        return httpIoStateType().base_io.vtable.netRead(userdata, socket_handle, buffers);
    }

    fn httpIo() std.Io {
        if (!httpIoStateType().initialized) {
            httpIoStateType().base_io = httpIoStateType().threaded.io();
            httpIoStateType().vtable = httpIoStateType().base_io.vtable.*;
            httpIoStateType().vtable.netRead = timeoutNetRead;
            httpIoStateType().io = .{
                .userdata = httpIoStateType().base_io.userdata,
                .vtable = &httpIoStateType().vtable,
            };
            httpIoStateType().initialized = true;
        }
        return httpIoStateType().io;
    }

    fn setReadTimeout(timeout_ms: i64) void {
        _ = httpIo();
        httpIoStateType().timeout = if (timeout_ms <= 0)
            .none
        else
            .{ .deadline = .fromNow(
                httpIoStateType().base_io,
                .{
                    .raw = .{ .nanoseconds = @as(i96, timeout_ms) * std.time.ns_per_ms },
                    .clock = .awake,
                },
            ) };
    }

    fn validHeaderName(name: []const u8) bool {
        if (name.len == 0) return false;
        for (name) |c| {
            if (std.ascii.isAlphanumeric(c)) continue;
            if (std.mem.indexOfScalar(u8, "!#$%&'*+-.^_`|~", c) == null) return false;
        }
        return true;
    }

    fn parseRequestHeaders(allocator: std.mem.Allocator, blob: []const u8) !std.array_list.Managed(std.http.Header) {
        var headers = std.array_list.Managed(std.http.Header).init(allocator);
        errdefer headers.deinit();
        var lines = std.mem.splitSequence(u8, blob, "\r\n");
        while (lines.next()) |line| {
            if (line.len == 0) continue;
            const colon = std.mem.indexOfScalar(u8, line, ':') orelse return error.InvalidArgument;
            const name = line[0..colon];
            const value = std.mem.trim(u8, line[colon + 1 ..], " \t");
            if (!validHeaderName(name) or std.mem.indexOfAny(u8, value, "\r\n") != null) return error.InvalidArgument;
            for (value) |c| {
                if ((c < 32 and c != '\t') or c == 127) return error.InvalidArgument;
            }
            if (
                std.ascii.eqlIgnoreCase(name, "host") or
                std.ascii.eqlIgnoreCase(name, "content-length") or
                std.ascii.eqlIgnoreCase(name, "transfer-encoding") or
                std.ascii.eqlIgnoreCase(name, "connection")) return error.InvalidArgument;
            try headers.append(.{ .name = name, .value = value });
        }
        return headers;
    }

    fn isCredentialHeader(name: []const u8) bool {
        return std.ascii.eqlIgnoreCase(name, "authorization") or
            std.ascii.eqlIgnoreCase(name, "proxy-authorization") or
            std.ascii.eqlIgnoreCase(name, "cookie") or
            std.ascii.eqlIgnoreCase(name, "cookie2");
    }

    fn sameOrigin(a: std.Uri, b: std.Uri) bool {
        if (!std.ascii.eqlIgnoreCase(a.scheme, b.scheme)) return false;
        const protocol_a = std.http.Client.Protocol.fromUri(a) orelse return false;
        const protocol_b = std.http.Client.Protocol.fromUri(b) orelse return false;
        if (protocol_a != protocol_b) return false;
        var host_a_buffer: [std.Io.net.HostName.max_len]u8 = undefined;
        var host_b_buffer: [std.Io.net.HostName.max_len]u8 = undefined;
        const host_a = a.getHost(&host_a_buffer) catch return false;
        const host_b = b.getHost(&host_b_buffer) catch return false;
        const default_port_a: u16 = if (protocol_a == .tls) 443 else 80;
        const default_port_b: u16 = if (protocol_b == .tls) 443 else 80;
        return std.Io.net.HostName.eql(host_a, host_b) and
            (a.port orelse default_port_a) == (b.port orelse default_port_b);
    }

    fn stripRedirectCredentials(headers: *std.array_list.Managed(std.http.Header)) void {
        var kept: usize = 0;
        for (headers.items) |header| {
            if (isCredentialHeader(header.name)) continue;
            headers.items[kept] = header;
            kept += 1;
        }
        headers.items.len = kept;
    }

    fn parseMethod(method: []const u8) ?std.http.Method {
        return std.meta.stringToEnum(std.http.Method, method);
    }

    // A connection is Zig-owned state outside the Doxa arena system: the ABI
    // crosses only scalars and `string`, so a `ConnectionState` can never be a
    // Doxa value. Doxa holds an opaque `int` handle instead, exactly as the
    // json module holds node handles. The struct is heap-pinned because
    // `std.http.Server` and the stream `Reader`/`Writer` recover each other via
    // `@fieldParentPtr`, so their addresses must never move.
    fn listenerStateType() type {
        return struct {
            socket_handle: std.Io.net.Socket.Handle,
            address: std.Io.net.IpAddress,
            options: std.Io.net.Server.AcceptOptions,
        };
    }

    fn connectionStateType() type {
        return struct {
            stream: std.Io.net.Stream,
            read_buffer: [16 * 1024]u8 = undefined,
            write_buffer: [8 * 1024]u8 = undefined,
            reader: std.Io.net.Stream.Reader = undefined,
            writer: std.Io.net.Stream.Writer = undefined,
            server: std.http.Server = undefined,
            request: ?std.http.Server.Request = null,
            method: []const u8 = "",
            target: []const u8 = "",
            head: []const u8 = "",
            body: []const u8 = "",
            keep_alive: bool = false,
            is_websocket: bool = false,
            ws_closed: bool = false,
            ws_peer_closed: bool = false,
            ws_frag_opcode: u4 = 0,
            ws_frag: std.ArrayList(u8) = .empty,
            ws_msg_op: i64 = 0,
            ws_msg_data: []const u8 = "",
        };
    }

    fn serverStateType() type {
        return struct {
            var listeners: std.AutoHashMapUnmanaged(i64, listenerStateType()) = .{};
            var connections: std.AutoHashMapUnmanaged(i64, *connectionStateType()) = .{};
            var next_handle: i64 = 1;
        };
    }

    // Handles are drawn from one monotonic counter shared by listeners and
    // connections, so a stale handle always resolves to `null` rather than to
    // whichever object later reused the number.
    fn allocHandle() i64 {
        const handle = serverStateType().next_handle;
        serverStateType().next_handle += 1;
        return handle;
    }

    fn connectionOf(handle: i64) ?*connectionStateType() {
        return serverStateType().connections.get(handle);
    }

    fn freeOwned(bytes: *[]const u8) void {
        if (bytes.*.len != 0) std.heap.page_allocator.free(@constCast(bytes.*));
        bytes.* = "";
    }

    fn destroyConnection(state: *connectionStateType()) void {
        freeOwned(&state.target);
        freeOwned(&state.head);
        freeOwned(&state.body);
        state.ws_frag.deinit(std.heap.page_allocator);
        state.stream.close(httpIo());
        std.heap.page_allocator.destroy(state);
    }


    fn mapNetworkError(err_name: []const u8) i64 {
        const common = mapCommon(err_name);
        if (common >= 0) return common;
        if (std.mem.eql(u8, err_name, "Timeout")) return 115;
        if (std.mem.eql(u8, err_name, "InvalidAddress") or
            std.mem.eql(u8, err_name, "InvalidPort") or
            std.mem.eql(u8, err_name, "AddressFamilyUnsupported")) return 1;
        if (std.mem.eql(u8, err_name, "OutOfMemory")) return 2;
        return 114;
    }

    pub fn listen(port: i64) i64 {
        clearLastError();
        if (port < 0 or port > 65535) {
            setLastError(1);
            return 0;
        }
        const io = httpIo();
        const address: std.Io.net.IpAddress = .{ .ip4 = .loopback(@intCast(port)) };
        var server = address.listen(io, .{ .reuse_address = true }) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return 0;
        };
        const handle = allocHandle();
        serverStateType().listeners.put(std.heap.page_allocator, handle, .{
            .socket_handle = server.socket.handle,
            .address = server.socket.address,
            .options = server.options,
        }) catch {
            server.deinit(io);
            setLastError(2);
            return 0;
        };
        return handle;
    }

    pub fn localAddr(handle: i64) i64 {
        clearLastError();
        if (serverStateType().listeners.get(handle)) |listener| return listener.address.getPort();
        setLastError(1);
        return 0;
    }

    fn acceptConnection(listener: listenerStateType()) i64 {
        var server: std.Io.net.Server = .{
            .socket = .{ .handle = listener.socket_handle, .address = listener.address },
            .options = listener.options,
        };
        const stream = server.accept(httpIo()) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return 0;
        };
        const allocator = std.heap.page_allocator;
        const state = allocator.create(connectionStateType()) catch {
            stream.close(httpIo());
            setLastError(2);
            return 0;
        };
        state.stream = stream;
        state.reader = stream.reader(httpIo(), &state.read_buffer);
        state.writer = stream.writer(httpIo(), &state.write_buffer);
        state.server = std.http.Server.init(&state.reader.interface, &state.writer.interface);
        state.request = null;
        state.method = "";
        state.target = "";
        state.head = "";
        state.body = "";
        state.keep_alive = false;
        state.is_websocket = false;
        state.ws_closed = false;
        state.ws_peer_closed = false;
        state.ws_frag_opcode = 0;
        state.ws_frag = .empty;
        state.ws_msg_op = 0;
        state.ws_msg_data = "";
        const connection_handle = allocHandle();
        serverStateType().connections.put(allocator, connection_handle, state) catch {
            state.stream.close(httpIo());
            allocator.destroy(state);
            setLastError(2);
            return 0;
        };
        return connection_handle;
    }

    pub fn accept(handle: i64) i64 {
        clearLastError();
        const listener = serverStateType().listeners.get(handle) orelse {
            setLastError(1);
            return 0;
        };
        return acceptConnection(listener);
    }


    pub fn readRequest(handle: i64) i64 {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return 1;
        };
        freeOwned(&state.target);
        freeOwned(&state.head);
        freeOwned(&state.body);
        state.request = state.server.receiveHead() catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return 1;
        };
        const request = &state.request.?;
        state.method = @tagName(request.head.method);
        state.target = copyToPage(request.head.target) orelse {
            setLastError(2);
            return 1;
        };
        state.head = copyToPage(request.head_buffer) orelse {
            setLastError(2);
            return 1;
        };
        state.keep_alive = request.head.keep_alive;
        return 0;
    }

    pub fn requestMethod(handle: i64) []const u8 {
        const state = connectionOf(handle) orelse return "";
        return state.method;
    }

    pub fn requestTarget(handle: i64) []const u8 {
        const state = connectionOf(handle) orelse return "";
        return state.target;
    }

    pub fn requestHead(handle: i64) []const u8 {
        const state = connectionOf(handle) orelse return "";
        return state.head;
    }

    pub fn requestBody(handle: i64) []const u8 {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return "";
        };
        const request = if (state.request) |*request| request else {
            setLastError(1);
            return "";
        };
        freeOwned(&state.body);
        var transfer_buffer: [16 * 1024]u8 = undefined;
        const body_reader = request.readerExpectNone(&transfer_buffer);
        var collected: std.array_list.Aligned(u8, .of(u8)) = .empty;
        defer collected.deinit(std.heap.page_allocator);
        body_reader.appendRemaining(std.heap.page_allocator, &collected, .limited(1024 * 1024)) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return "";
        };
        state.body = copyToPage(collected.items) orelse {
            setLastError(2);
            return "";
        };
        return state.body;
    }

    pub fn keepAlive(handle: i64) bool {
        const state = connectionOf(handle) orelse return false;
        return state.keep_alive;
    }

    // Route-pattern matching. The Router itself is Doxa data (verbs, patterns,
    // ids); only the pattern/path segmentation lives here, where splitting a
    // string is a library call rather than a hand-rolled scan. Captures are
    // stashed in process-lifetime cells and drained by the Doxa matcher before
    // the next call, mirroring the take-and-clear idiom used elsewhere.
    fn routeStateType() type {
        return struct {
            var param_names: [32][]const u8 = undefined;
            var param_values: [32][]const u8 = undefined;
            var param_count: usize = 0;
        };
    }

    fn segmentEnd(text: []const u8, start: usize) usize {
        var i = start;
        while (i < text.len and text[i] != '/') : (i += 1) {}
        return i;
    }

    // A `:name` segment captures the corresponding path segment as `name`.
    // `{}` is deliberately avoided: Doxa string literals interpolate on `{`,
    // so a brace-delimited placeholder could never be written literally.
    pub fn matchPattern(pattern: []const u8, path: []const u8) i64 {
        const state = routeStateType();
        state.param_count = 0;
        var p: usize = 0;
        var q: usize = 0;
        while (true) {
            const p_end = segmentEnd(pattern, p);
            const q_end = segmentEnd(path, q);
            const p_segment = pattern[p..p_end];
            const q_segment = path[q..q_end];
            if (p_segment.len >= 2 and p_segment[0] == ':') {
                if (state.param_count >= state.param_names.len) return 0;
                state.param_names[state.param_count] = p_segment[1..];
                state.param_values[state.param_count] = q_segment;
                state.param_count += 1;
            } else if (!std.mem.eql(u8, p_segment, q_segment)) {
                return 0;
            }
            const p_done = p_end >= pattern.len;
            const q_done = q_end >= path.len;
            if (p_done or q_done) return if (p_done and q_done) 1 else 0;
            p = p_end + 1;
            q = q_end + 1;
        }
    }

    pub fn paramCount() i64 {
        return @intCast(routeStateType().param_count);
    }

    pub fn paramNameAt(index: i64) []const u8 {
        if (index < 0) return "";
        const state = routeStateType();
        const i: usize = @intCast(index);
        if (i >= state.param_count) return "";
        return state.param_names[i];
    }

    pub fn paramValueAt(index: i64) []const u8 {
        if (index < 0) return "";
        const state = routeStateType();
        const i: usize = @intCast(index);
        if (i >= state.param_count) return "";
        return state.param_values[i];
    }



    fn validHeaderBlob(headers: []const u8) bool {
        if (std.mem.indexOf(u8, headers, "\r\n\r\n") != null) return false;
        var lines = std.mem.splitSequence(u8, headers, "\r\n");
        while (lines.next()) |line| {
            if (line.len == 0) continue;
            const colon = std.mem.indexOfScalar(u8, line, ':') orelse return false;
            if (colon == 0) return false;
            const name = line[0..colon];
            if (std.ascii.eqlIgnoreCase(name, "content-length") or
                std.ascii.eqlIgnoreCase(name, "transfer-encoding") or
                std.ascii.eqlIgnoreCase(name, "connection")) return false;
            for (name) |c| {
                if (c <= 32 or c >= 127 or c == ':') return false;
            }
        }
        for (headers, 0..) |c, i| {
            if (c == '\n' and (i == 0 or headers[i - 1] != '\r')) return false;
            if (c == '\r' and (i + 1 == headers.len or headers[i + 1] != '\n')) return false;
        }
        return true;
    }

    pub fn respond(handle: i64, status: i64, headers: []const u8, body: []const u8) void {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return;
        };
        const request = if (state.request) |*request| request else {
            setLastError(1);
            return;
        };
        if (status < 100 or status > 999 or !validHeaderBlob(headers)) {
            setLastError(1);
            return;
        }
        const parsed = parseRequestHeaders(std.heap.page_allocator, headers) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return;
        };
        defer parsed.deinit();
        request.respond(body, .{
            .status = @enumFromInt(@as(u10, @intCast(status))),
            .keep_alive = state.keep_alive,
            .extra_headers = parsed.items,
        }) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return;
        };
        state.request = null;
    }

    // Server-side WebSockets. Zig ships the handshake (`respondWebSocket`) and
    // the write half (`WebSocket.writeMessage`) but its `readSmallMessage` is
    // single-frame, input-buffer-bounded, rejects fragmentation, and silently
    // drops pongs, so the read path is a real frame codec here. Decoding draws
    // from the connection's buffered reader, one message (or control frame) at
    // a time; a fragmented message is reassembled in `ws_frag` up to the size
    // cap before it is surfaced.
    fn wsUnmask(payload: []u8, mask: u32) void {
        const mask_bytes: [4]u8 = @bitCast(mask);
        for (payload, 0..) |*byte, i| byte.* ^= mask_bytes[i % 4];
    }

    fn wsOpcodeFromCode(code: i64) ?std.http.Server.WebSocket.Opcode {
        return switch (code) {
            1 => .text,
            2 => .binary,
            8 => .connection_close,
            9 => .ping,
            10 => .pong,
            else => null,
        };
    }

    fn wsCodeFromOpcode(op: std.http.Server.WebSocket.Opcode) i64 {
        return switch (op) {
            .text => 1,
            .binary => 2,
            .connection_close => 8,
            .ping => 9,
            .pong => 10,
            else => 0,
        };
    }

    fn wsOf(state: *connectionStateType()) std.http.Server.WebSocket {
        return .{
            .key = "",
            .input = state.server.reader.in,
            .output = state.server.out,
        };
    }

    fn wsWrite(state: *connectionStateType(), opcode: std.http.Server.WebSocket.Opcode, data: []const u8) !void {
        var ws = wsOf(state);
        try ws.writeMessage(data, opcode);
    }

    // Fail the WebSocket connection (RFC 6455 §7.1.7): emit a Close frame with
    // the status code, then stop reading and writing.
    fn wsFail(state: *connectionStateType(), code: u16) void {
        var payload: [2]u8 = undefined;
        std.mem.writeInt(u16, &payload, code, .big);
        wsWrite(state, .connection_close, &payload) catch {};
        state.ws_closed = true;
    }

    // The error set is spelled `anyerror` because the inline-Zig extractor only
    // accepts scalar signatures on exported functions and its brace scanner
    // cannot see an `error{...}` literal in a private signature; `wsNext` maps
    // the concrete errors it expects and treats the rest as transport failures.
    fn wsDecode(state: *connectionStateType()) anyerror!std.http.Server.WebSocket.Opcode {
        const in = state.server.reader.in;
        const max_message_size: usize = 16 * 1024 * 1024;
        while (true) {
            const header = try in.takeArray(2);
            const h0: std.http.Server.WebSocket.Header0 = @bitCast(header[0]);
            const h1: std.http.Server.WebSocket.Header1 = @bitCast(header[1]);

            const is_control = switch (h0.opcode) {
                .connection_close, .ping, .pong => true,
                .continuation, .text, .binary => false,
                else => return error.WsProtocol,
            };
            if (h0.rsv1 != 0 or h0.rsv2 != 0 or h0.rsv3 != 0) return error.WsProtocol;
            if (!h1.mask) return error.WsProtocol;
            if (is_control and !h0.fin) return error.WsProtocol;

            const len: usize = switch (h1.payload_len) {
                .len16 => try in.takeInt(u16, .big),
                .len64 => std.math.cast(usize, try in.takeInt(u64, .big)) orelse return error.WsOversize,
                else => @intFromEnum(h1.payload_len),
            };
            if (is_control and len > 125) return error.WsProtocol;

            const pending: usize = if (h0.opcode == .continuation)
                state.ws_frag.items.len + len
            else
                len;
            if (pending > max_message_size) return error.WsOversize;

            const mask: u32 = @bitCast((try in.takeArray(4)).*);
            const payload = try in.take(len);
            wsUnmask(payload, mask);

            switch (h0.opcode) {
                .continuation => {
                    if (state.ws_frag_opcode == 0) return error.WsProtocol;
                    try state.ws_frag.appendSlice(std.heap.page_allocator, payload);
                    if (h0.fin) {
                        state.ws_msg_data = state.ws_frag.items;
                        const op: std.http.Server.WebSocket.Opcode =
                            if (state.ws_frag_opcode == 1) .text else .binary;
                        state.ws_frag_opcode = 0;
                        return op;
                    }
                },
                .text, .binary => {
                    if (state.ws_frag_opcode != 0) return error.WsProtocol;
                    if (h0.fin) {
                        state.ws_msg_data = payload;
                        return h0.opcode;
                    }
                    state.ws_frag.clearRetainingCapacity();
                    try state.ws_frag.appendSlice(std.heap.page_allocator, payload);
                    state.ws_frag_opcode = @intFromEnum(h0.opcode);
                },
                .ping, .pong, .connection_close => {
                    state.ws_msg_data = payload;
                    if (h0.opcode == .connection_close) state.ws_peer_closed = true;
                    return h0.opcode;
                },
                else => return error.WsProtocol,
            }
        }
    }

    // Upgrade a request that asked to switch protocols to a WebSocket. The
    // connection must hold a pending request from `readRequest`.
    pub fn upgradeWebSocket(handle: i64) i64 {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return 1;
        };
        if (state.is_websocket) {
            setLastError(1);
            return 1;
        }
        const request = if (state.request) |*request| request else {
            setLastError(1);
            return 1;
        };
        const key = switch (request.upgradeRequested()) {
            .websocket => |maybe_key| maybe_key orelse {
                setLastError(1);
                return 1;
            },
            else => {
                setLastError(1);
                return 1;
            },
        };
        _ = request.respondWebSocket(.{ .key = key }) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return 1;
        };
        state.writer.interface.flush() catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return 1;
        };
        state.is_websocket = true;
        state.request = null;
        return 0;
    }

    pub fn wsSend(handle: i64, op: i64, data: []const u8) void {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return;
        };
        if (!state.is_websocket or state.ws_closed) {
            setLastError(1);
            return;
        }
        const opcode = wsOpcodeFromCode(op) orelse {
            setLastError(1);
            return;
        };
        wsWrite(state, opcode, data) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return;
        };
    }

    // Returns 1 when a message is ready (`wsMessageOp`/`wsMessageData`), 0 when
    // the connection is finished (clean EOF or a peer close already reported),
    // and -1 on protocol/transport failure with `takeLastErrorCode` set.
    pub fn wsNext(handle: i64) i64 {
        clearLastError();
        const state = connectionOf(handle) orelse {
            setLastError(1);
            return -1;
        };
        if (!state.is_websocket) {
            setLastError(1);
            return -1;
        }
        if (state.ws_closed or state.ws_peer_closed) return 0;
        const opcode = wsDecode(state) catch |err| switch (err) {
            error.EndOfStream => {
                state.ws_closed = true;
                return 0;
            },
            error.WsOversize => {
                wsFail(state, 1009);
                setLastError(113);
                return -1;
            },
            error.WsProtocol => {
                wsFail(state, 1002);
                setLastError(113);
                return -1;
            },
            error.OutOfMemory => {
                setLastError(2);
                return -1;
            },
            error.ReadFailed => {
                if (state.reader.err) |read_err| {
                    setLastError(mapNetworkError(@errorName(read_err)));
                } else {
                    setLastError(114);
                }
                return -1;
            },
            else => {
                setLastError(114);
                return -1;
            },
        };
        state.ws_msg_op = wsCodeFromOpcode(opcode);
        return 1;
    }

    pub fn wsMessageOp(handle: i64) i64 {
        const state = connectionOf(handle) orelse return 0;
        return state.ws_msg_op;
    }

    pub fn wsMessageData(handle: i64) []const u8 {
        const state = connectionOf(handle) orelse return "";
        return state.ws_msg_data;
    }

    // Whether the connection's reader already holds undecoded bytes. A poll loop
    // drains with this because a frame that arrived with (or pipelined behind)
    // the handshake is already off the socket and invisible to `poll`.
    pub fn wsBuffered(handle: i64) bool {
        const state = connectionOf(handle) orelse return false;
        return state.server.reader.in.bufferedLen() > 0;
    }

    pub fn close(handle: i64) void {
        clearLastError();
        if (serverStateType().connections.fetchRemove(handle)) |entry| {
            destroyConnection(entry.value);
            return;
        }
        if (serverStateType().listeners.fetchRemove(handle)) |entry| {
            const socket: std.Io.net.Socket = .{
                .handle = entry.value.socket_handle,
                .address = entry.value.address,
            };
            socket.close(httpIo());
            return;
        }
        setLastError(1);
    }

    // Readiness polling over the listener plus every live connection. Event
    // kinds are 1 = a new connection was accepted, 2 = readable, 3 = the peer
    // closed or errored. The loop owns the wait; Doxa only drains `Event[]`.
    fn eventStateType() type {
        return struct {
            var handles: [64]i64 = undefined;
            var kinds: [64]i64 = undefined;
            var count: usize = 0;
        };
    }

    pub fn eventCount() i64 {
        return @intCast(eventStateType().count);
    }

    pub fn eventHandle(index: i64) i64 {
        if (index < 0 or index >= eventCount()) return 0;
        return eventStateType().handles[@intCast(index)];
    }

    pub fn eventKind(index: i64) i64 {
        if (index < 0 or index >= eventCount()) return 0;
        return eventStateType().kinds[@intCast(index)];
    }

    fn pushEvent(handle: i64, kind: i64) void {
        const state = eventStateType();
        if (state.count >= state.handles.len) return;
        state.handles[state.count] = handle;
        state.kinds[state.count] = kind;
        state.count += 1;
    }

    // Each socket is polled through the Threaded backend's own APC batch, one
    // `AFD_POLL` per handle, submitted concurrently. AFD cannot aggregate
    // handles from different endpoints in a single poll (a second exclusive
    // poll is rejected, and `NtCancelIoFileEx` never completes one), so the
    // wait gives every poll a bounded timeout, lets them all complete
    // naturally, and reports what became ready. This keeps the whole wait
    // inside the backend's alertable APC discipline instead of a serial tick.
    fn waitSet(handles: []const std.Io.net.Socket.Handle, listener_slot: usize, timeout_ms: i64, ready: []bool, closed: []bool) void {
        if (comptime builtin.os.tag == .windows) {
            const AfdPollHandle = extern struct {
                handle: std.os.windows.HANDLE,
                events: u32,
                status: std.os.windows.NTSTATUS,
            };
            const AfdPoll = extern struct {
                timeout: i64,
                count: u32,
                exclusive: std.os.windows.BOOLEAN,
                padding: [3]u8,
                handles: [1]AfdPollHandle,
            };
            const n = @min(handles.len, 64);
            if (n == 0) return;
            const io = httpIo();
            const tick_ms: i64 = 10;
            const immediate = timeout_ms == 0;
            const tick_100ns: i64 = if (immediate) 1 else tick_ms * std.time.ns_per_ms / 100;
            var waited_ms: i64 = 0;
            while (true) {
                var polls: [64]AfdPoll = undefined;
                var storage: [64]std.Io.Operation.Storage = undefined;
                var batch = std.Io.Batch.init(storage[0..n]);
                for (handles[0..n], 0..) |native, i| {
                    polls[i] = .{
                        .timeout = -tick_100ns,
                        .count = 1,
                        .exclusive = .FALSE,
                        .padding = .{ 0, 0, 0 },
                        .handles = .{.{
                            .handle = native,
                            // Accept readiness for the listener; receive +
                            // peer-close for connected sockets (AFD.POLL bits).
                            .events = if (i == listener_slot)
                                0x0080 | 0x0010 | 0x0020
                            else
                                0x0001 | 0x0008 | 0x0010 | 0x0020,
                            .status = .SUCCESS,
                        }},
                    };
                    const bytes = std.mem.asBytes(&polls[i]);
                    _ = batch.add(.{ .device_io_control = .{
                        .file = .{ .handle = native, .flags = .{ .nonblocking = true } },
                        .code = std.os.windows.IOCTL.AFD.POLL,
                        .in = bytes,
                        .out = bytes,
                    } });
                }
                var any = false;
                const tick_deadline: std.Io.Timeout = .{ .deadline = .fromNow(
                    httpIoStateType().base_io,
                    .{
                        .raw = .{ .nanoseconds = @as(i96, tick_ms + 100) * std.time.ns_per_ms },
                        .clock = .awake,
                    },
                ) };
                while (batch.submitted.head != .none or batch.pending.head != .none or batch.completed.head != .none) {
                    if (batch.completed.head == .none) {
                        batch.awaitConcurrent(io, tick_deadline) catch break;
                    }
                    while (batch.next()) |completion| {
                        const i: usize = completion.index;
                        if (completion.result.device_io_control.u.Status != .SUCCESS) continue;
                        const events = polls[i].handles[0].events;
                        const status = polls[i].handles[0].status;
                        if (i == listener_slot) {
                            if (events & (0x0080 | 0x0010 | 0x0020) != 0) {
                                ready[i] = true;
                                any = true;
                            }
                        } else if (events & 0x0001 != 0) {
                            ready[i] = true;
                            any = true;
                        } else if (events & (0x0008 | 0x0010 | 0x0020) != 0 or
                            status == .CONNECTION_RESET or status == .CONNECTION_ABORTED)
                        {
                            closed[i] = true;
                            any = true;
                        }
                    }
                }
                // Every poll in the batch is bounded by the tick, so before the
                // stack buffers go away, wait out any stragglers.
                while (batch.pending.head != .none) std.Io.Threaded.waitForApcOrAlert();
                if (any or immediate) return;
                waited_ms += tick_ms;
                if (timeout_ms >= 0 and waited_ms >= timeout_ms) return;
            }
        }

        if (comptime builtin.os.tag == .wasi or builtin.os.tag == .uefi or builtin.os.tag == .freestanding) return;


        var fds: [64]std.posix.pollfd = undefined;
        for (handles, 0..) |native, i| {
            fds[i] = .{ .fd = native, .events = std.posix.POLL.IN, .revents = 0 };
        }
        const timeout_i32: i32 = if (timeout_ms < 0)
            -1
        else
            @intCast(@min(timeout_ms, std.math.maxInt(i32)));
        const waited = std.posix.poll(fds[0..handles.len], timeout_i32) catch return;
        if (waited == 0) return;
        for (handles, 0..) |_, i| {
            const revents = fds[i].revents;
            if (revents & std.posix.POLL.IN != 0) {
                ready[i] = true;
            } else if (revents & (std.posix.POLL.HUP | std.posix.POLL.ERR | std.posix.POLL.NVAL) != 0) {
                closed[i] = true;
            }
        }
    }

    pub fn poll(listener_handle: i64, timeout_ms: i64) i64 {
        clearLastError();
        const state = eventStateType();
        state.count = 0;
        const listener = serverStateType().listeners.get(listener_handle) orelse {
            setLastError(1);
            return -1;
        };
        var handles: [64]std.Io.net.Socket.Handle = undefined;
        var ids: [64]i64 = undefined;
        var is_listener: [64]bool = undefined;
        var n: usize = 0;
        handles[0] = listener.socket_handle;
        ids[0] = listener_handle;
        is_listener[0] = true;
        n = 1;
        var it = serverStateType().connections.iterator();
        while (it.next()) |entry| {
            if (n >= handles.len) break;
            handles[n] = entry.value_ptr.*.stream.socket.handle;
            ids[n] = entry.key_ptr.*;
            is_listener[n] = false;
            n += 1;
        }
        var ready: [64]bool = [_]bool{false} ** 64;
        var closed: [64]bool = [_]bool{false} ** 64;
        waitSet(handles[0..n], 0, timeout_ms, ready[0..n], closed[0..n]);
        var i: usize = 0;
        while (i < n) : (i += 1) {
            if (is_listener[i]) {
                if (ready[i]) {
                    const connection = acceptConnection(listener);
                    if (connection != 0) pushEvent(connection, 1);
                }
                continue;
            }
            if (ready[i]) {
                pushEvent(ids[i], 2);
            } else if (closed[i]) {
                pushEvent(ids[i], 3);
            }
        }
        return @intCast(state.count);
    }

    fn clientStateType() type {
        return struct {
            var client: ?std.http.Client = null;
            var status_code: i64 = 0;
            var raw_headers: []const u8 = "";
            var owned_raw_headers: []const u8 = "";
        };
    }

    fn httpClient() *std.http.Client {
        if (clientStateType().client == null) {
            clientStateType().client = .{
                .allocator = std.heap.page_allocator,
                .io = httpIo(),
            };
        }
        return &clientStateType().client.?;
    }

    fn copyToPage(bytes: []const u8) ?[]const u8 {
        if (bytes.len == 0) return "";
        return std.heap.page_allocator.dupe(u8, bytes) catch null;
    }

    pub fn takeStatusCode() i64 {
        const status = clientStateType().status_code;
        clientStateType().status_code = 0;
        return status;
    }

    pub fn takeResponseHeaders() []const u8 {
        const headers = clientStateType().raw_headers;
        clientStateType().raw_headers = "";
        return headers;
    }

    fn requestResultType() type {
        return struct {
            var body: []const u8 = "";
        };
    }

    fn requestCore(
        method_name: []const u8,
        url: []const u8,
        header_blob: []const u8,
        body_bytes: []const u8,
        timeout_ms: i64,
        max_redirects: i64,
        response_writer: ?*std.Io.Writer,
    ) bool {
        clearLastError();
        if (clientStateType().owned_raw_headers.len != 0) {
            std.heap.page_allocator.free(@constCast(clientStateType().owned_raw_headers));
        }
        if (requestResultType().body.len != 0) std.heap.page_allocator.free(@constCast(requestResultType().body));
        clientStateType().owned_raw_headers = "";
        requestResultType().body = "";
        clientStateType().status_code = 0;
        clientStateType().raw_headers = "";
        if (url.len == 0 or timeout_ms < 0 or max_redirects < 0 or max_redirects >= std.math.maxInt(u16)) {
            setLastError(1);
            return false;
        }
        var method = parseMethod(method_name) orelse {
            setLastError(1);
            return false;
        };
        if (body_bytes.len != 0 and !method.requestHasBody()) {
            setLastError(1);
            return false;
        }

        const allocator = std.heap.page_allocator;
        var headers = parseRequestHeaders(allocator, header_blob) catch |err| {
            setLastError(mapNetworkError(@errorName(err)));
            return false;
        };
        defer headers.deinit();
        var uri = std.Uri.parse(url) catch {
            setLastError(1);
            return false;
        };
        setReadTimeout(timeout_ms);
        defer setReadTimeout(0);

        var redirects_left: u16 = @intCast(max_redirects);
        var redirect_buffers: [2][8 * 1024]u8 = undefined;
        var redirect_buffer_index: usize = 0;
        while (true) {
            var client_request = httpClient().request(method, uri, .{
                .redirect_behavior = .unhandled,
                .headers = .{ .accept_encoding = .omit },
                .extra_headers = headers.items,
            }) catch |err| {
                setLastError(mapNetworkError(@errorName(err)));
                return false;
            };
            defer client_request.deinit();

            if (method.requestHasBody()) {
                const mutable_body = allocator.dupe(u8, body_bytes) catch {
                    setLastError(2);
                    return false;
                };
                defer allocator.free(mutable_body);
                client_request.sendBodyComplete(mutable_body) catch |err| {
                    if (client_request.connection) |connection| {
                        if (connection.stream_writer.err) |write_err| {
                            setLastError(mapNetworkError(@errorName(write_err)));
                            return false;
                        }
                    }
                    setLastError(mapNetworkError(@errorName(err)));
                    return false;
                };
            } else {
                client_request.sendBodiless() catch |err| {
                    setLastError(mapNetworkError(@errorName(err)));
                    return false;
                };
            }

            var response = client_request.receiveHead(&.{}) catch |err| {
                if (client_request.connection) |connection| {
                    if (connection.stream_reader.err) |read_err| {
                        setLastError(mapNetworkError(@errorName(read_err)));
                        return false;
                    }
                }
                setLastError(mapNetworkError(@errorName(err)));
                return false;
            };

            if (response.head.status.class() == .redirect and redirects_left > 0) {
                const location = response.head.location orelse {
                    setLastError(114);
                    return false;
                };
                redirect_buffer_index = 1 - redirect_buffer_index;
                const redirect_buffer = &redirect_buffers[redirect_buffer_index];
                if (location.len > redirect_buffer.len) {
                    setLastError(114);
                    return false;
                }
                @memcpy(redirect_buffer[0..location.len], location);
                const old_uri = uri;
                var aux: []u8 = redirect_buffer[0..];
                uri = uri.resolveInPlace(location.len, &aux) catch {
                    setLastError(114);
                    return false;
                };
                var discard_buffer: [1024]u8 = undefined;
                const redirect_reader = response.reader(&discard_buffer);
                _ = redirect_reader.discardRemaining() catch |err| {
                    setLastError(mapNetworkError(@errorName(err)));
                    return false;
                };
                if (!sameOrigin(old_uri, uri)) stripRedirectCredentials(&headers);
                redirects_left -= 1;
                if (response.head.status == .see_other or
                    ((response.head.status == .moved_permanently or response.head.status == .found) and method == .POST))
                {
                    method = .GET;
                }
                continue;
            }
            if (response.head.status.class() == .redirect and redirects_left == 0 and response.head.location != null) {
                setLastError(114);
                return false;
            }

            clientStateType().status_code = @intFromEnum(response.head.status);
            clientStateType().owned_raw_headers = copyToPage(response.head.bytes) orelse {
                setLastError(2);
                return false;
            };
            clientStateType().raw_headers = clientStateType().owned_raw_headers;
            var transfer_buffer: [16 * 1024]u8 = undefined;
            const reader = response.reader(&transfer_buffer);
            if (response_writer) |writer| {
                _ = reader.streamRemaining(writer) catch |err| {
                    if (response.bodyErr()) |read_err| {
                        setLastError(mapNetworkError(@errorName(read_err)));
                    } else {
                        const common = mapCommon(@errorName(err));
                        setLastError(if (common >= 0) common else if (response_writer != null) 107 else mapNetworkError(@errorName(err)));
                    }
                    clientStateType().status_code = 0;
                    clientStateType().raw_headers = "";
                    return false;
                };
                return true;
            }

            var buffered_body: std.array_list.Aligned(u8, .of(u8)) = .empty;
            defer buffered_body.deinit(allocator);
            reader.appendRemaining(allocator, &buffered_body, .unlimited) catch |err| {
                if (response.bodyErr()) |read_err| {
                    setLastError(mapNetworkError(@errorName(read_err)));
                } else {
                    setLastError(mapNetworkError(@errorName(err)));
                }
                clientStateType().status_code = 0;
                clientStateType().raw_headers = "";
                return false;
            };
            requestResultType().body = copyToPage(buffered_body.items) orelse {
                setLastError(2);
                return false;
            };
            return true;
        }
    }

    pub fn performRequest(method: []const u8, url: []const u8, headers: []const u8, body: []const u8, timeout_ms: i64, max_redirects: i64) []const u8 {
        if (requestCore(method, url, headers, body, timeout_ms, max_redirects, null)) return requestResultType().body;
        return "";
    }

    pub fn requestToFile(method: []const u8, url: []const u8, headers: []const u8, body: []const u8, timeout_ms: i64, max_redirects: i64, destination: []const u8) void {
        clearLastError();
        const io = httpIo();
        var file = std.Io.Dir.cwd().createFile(io, destination, .{}) catch |err| {
            const common = mapCommon(@errorName(err));
            setLastError(if (common >= 0) common else 108);
            return;
        };
        defer file.close(io);
        var file_buffer: [16 * 1024]u8 = undefined;
        var file_writer = file.writer(io, &file_buffer);
        if (!requestCore(method, url, headers, body, timeout_ms, max_redirects, &file_writer.interface)) return;
        file_writer.interface.flush() catch |err| {
            const common = mapCommon(@errorName(err));
            setLastError(if (common >= 0) common else 107);
            return;
        };
        const status = clientStateType().status_code;
        if (status < 200 or status >= 300) setLastError(116);
    }

    pub fn getText(url: []const u8, timeout_ms: i64) []const u8 {
        return performRequest("GET", url, "", "", timeout_ms, 3);
    }

    fn headerAt(raw_headers: []const u8, wanted: usize) ?struct { name: []const u8, value: []const u8 } {
        var lines = std.mem.splitSequence(u8, raw_headers, "\r\n");
        _ = lines.next(); // status line
        var index: usize = 0;
        while (lines.next()) |line| {
            if (line.len == 0) break;
            const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
            if (index == wanted) return .{
                .name = line[0..colon],
                .value = std.mem.trim(u8, line[colon + 1 ..], " \t"),
            };
            index += 1;
        }
        return null;
    }

    pub fn headerCount(raw_headers: []const u8) i64 {
        var count: usize = 0;
        while (headerAt(raw_headers, count) != null) : (count += 1) {}
        return @intCast(count);
    }

    pub fn headerNameAt(raw_headers: []const u8, index: i64) []const u8 {
        if (index < 0) return "";
        return if (headerAt(raw_headers, @intCast(index))) |header| header.name else "";
    }

    pub fn headerValueAt(raw_headers: []const u8, index: i64) []const u8 {
        if (index < 0) return "";
        return if (headerAt(raw_headers, @intCast(index))) |header| header.value else "";
    }

    pub fn headerNameMatches(raw_headers: []const u8, index: i64, name: []const u8) bool {
        if (index < 0) return false;
        const header = headerAt(raw_headers, @intCast(index)) orelse return false;
        return std.ascii.eqlIgnoreCase(header.name, name);
    }

    pub fn mapCommon(err_name: []const u8) i64 {
        if (std.mem.eql(u8, err_name, "InvalidArgument")) return 1;
        if (std.mem.eql(u8, err_name, "OutOfMemory")) return 2;
        if (std.mem.eql(u8, err_name, "AccessDenied")) return 3;
        if (std.mem.eql(u8, err_name, "PermissionDenied")) return 3;
        if (std.mem.eql(u8, err_name, "NotSupported")) return 4;
        if (std.mem.eql(u8, err_name, "OperationNotSupported")) return 4;
        return -1;
    }

    pub fn filenameFromUrl(url: []const u8) []const u8 {
        const query_idx = std.mem.indexOfScalar(u8, url, '?');
        const without_query = if (query_idx) |idx| url[0..idx] else url;
        const fragment_idx = std.mem.indexOfScalar(u8, without_query, '#');
        const without_fragment = if (fragment_idx) |idx| without_query[0..idx] else without_query;
        const trimmed = std.mem.trimEnd(u8, without_fragment, "/");
        const slash_idx = std.mem.lastIndexOfScalar(u8, trimmed, '/');
        const name = if (slash_idx) |idx| trimmed[idx + 1 ..] else trimmed;
        return if (name.len == 0) "downloaded.bin" else name;
    }

    public fn downloadUrl(url: []const u8, destination: []const u8) void {
        if (url.len == 0 or destination.len == 0) {
            clearLastError();
            setLastError(1);
            return;
        }
        requestToFile("GET", url, "", "", 30000, 3, destination);
    }

    pub fn download(url: []const u8) void {
        clearLastError();
        const name = filenameFromUrl(url);
        downloadUrl(url, name);
    }

}

function mapIOError(code :: int) returns error.StdError {
    return match code {
        1 then error.Common.InvalidArgument,
        2 then error.Common.OutOfMemory,
        3 then error.Common.PermissionDenied,
        4 then error.Common.NotSupported,
        5 then error.Common.Unexpected,
        100 then error.IO.NotFound,
        101 then error.IO.AlreadyExists,
        102 then error.IO.NotDirectory,
        103 then error.IO.IsDirectory,
        104 then error.IO.InvalidPath,
        105 then error.IO.OpenFailed,
        106 then error.IO.ReadFailed,
        107 then error.IO.WriteFailed,
        108 then error.IO.CreateFailed,
        109 then error.IO.DeleteFailed,
        110 then error.IO.RenameFailed,
        111 then error.IO.CopyFailed,
        112 then error.IO.IterateFailed,
        113 then error.IO.InvalidData,
        114 then error.IO.ConnectionFailed,
        115 then error.IO.Timeout,
        116 then error.IO.HttpStatus,
        117 then error.IO.Unexpected,
        else error.Common.Unexpected,
    }
}

public function downloadUrl(url :: string, destination :: string) returns error.StdError {
    HTTP.downloadUrl(url, destination)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function download(url :: string) returns error.StdError {
    HTTP.download(url)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public struct Response {
    status_code :: int,
    raw_headers :: string,
    body_text :: string,

    public method statusCode() returns int {
        return this.status_code
    }

    public method body() returns string {
        return this.body_text
    }

    public method header(name :: string) returns string[] {
        var values :: string[]
        const count is HTTP.headerCount(this.raw_headers)
        for i while i < count do i += 1 {
            if HTTP.headerNameMatches(this.raw_headers, i, name) then {
                @push(values, HTTP.headerValueAt(this.raw_headers, i))
            }
        }
        return values
    }

    public method hasHeader(name :: string) returns tetra {
        const count is HTTP.headerCount(this.raw_headers)
        for i while i < count do i += 1 {
            if HTTP.headerNameMatches(this.raw_headers, i, name) then return true
        }
        return false
    }
}

function performGet(url :: string, timeout_ms :: int) returns Response | error.StdError {
    const value is HTTP.getText(url, timeout_ms)
    const status is HTTP.takeStatusCode()
    const headers is HTTP.takeResponseHeaders()
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return $Response {
        status_code is status,
        raw_headers is headers,
        body_text is value,
    }
    return mapIOError(err)
}

public function listen(port :: int) returns int | error.StdError {
    const handle is HTTP.listen(port)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return handle
    return mapIOError(err)
}

public function localAddr(handle :: int) returns int | error.StdError {
    const port is HTTP.localAddr(handle)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return port
    return mapIOError(err)
}

public function accept(handle :: int) returns int | error.StdError {
    const connection is HTTP.accept(handle)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return connection
    return mapIOError(err)
}

public struct ServerRequest {
    public verb :: string,
    public target :: string,
    public body_text :: string,
    raw_headers :: string,

    public method path() returns string {
        return this.target
    }

    public method body() returns string {
        return this.body_text
    }

    public method header(name :: string) returns string[] {
        var values :: string[]
        const count is HTTP.headerCount(this.raw_headers)
        for i while i < count do i += 1 {
            if HTTP.headerNameMatches(this.raw_headers, i, name) then {
                @push(values, HTTP.headerValueAt(this.raw_headers, i))
            }
        }
        return values
    }

    public method hasHeader(name :: string) returns tetra {
        const count is HTTP.headerCount(this.raw_headers)
        for i while i < count do i += 1 {
            if HTTP.headerNameMatches(this.raw_headers, i, name) then return true
        }
        return false
    }
}

public function readRequest(connection :: int) returns ServerRequest | error.StdError {
    const code is HTTP.readRequest(connection)
    if code != 0 then return mapIOError(HTTP.takeLastErrorCode())
    const verb is HTTP.requestMethod(connection)
    const target is HTTP.requestTarget(connection)
    const raw_headers is HTTP.requestHead(connection)
    const body is HTTP.requestBody(connection)
    const err is HTTP.takeLastErrorCode()
    if err != 0 then return mapIOError(err)
    return $ServerRequest {
        verb is verb,
        target is target,
        body_text is body,
        raw_headers is raw_headers,
    }
}

public function keepAlive(connection :: int) returns tetra {
    return HTTP.keepAlive(connection)
}

/* WebSocket frame kinds. The inline-Zig boundary only carries scalars, so the
   codes crossing it are the RFC 6455 opcodes and `wsOpFromCode`/`wsOpCode`
   translate to and from this enum. */
public enum WsOp {
    Text,
    Binary,
    Ping,
    Pong,
    Close,
}

/* One decoded WebSocket message. Data frames carry their payload; control
   frames (ping/pong/close) are surfaced so the caller owns the policy. */
public struct Message {
    public op :: WsOp,
    public data :: string,
}

function wsOpCode(op :: WsOp) returns int {
    if op == WsOp.Text then return 1
    if op == WsOp.Binary then return 2
    if op == WsOp.Ping then return 9
    if op == WsOp.Pong then return 10
    return 8
}

function wsOpFromCode(code :: int) returns WsOp {
    if code == 1 then return WsOp.Text
    if code == 2 then return WsOp.Binary
    if code == 9 then return WsOp.Ping
    if code == 10 then return WsOp.Pong
    return WsOp.Close
}

/* Complete the RFC 6455 handshake on an accepted connection whose pending
   request asked to upgrade. Call after `readRequest`, before `wsSend`/`wsNext`. */
public function upgradeWebSocket(connection :: int) returns error.StdError {
    HTTP.upgradeWebSocket(connection)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

/* Send one WebSocket frame with `data` as its payload. */
public function wsSend(connection :: int, op :: WsOp, data :: string) returns error.StdError {
    HTTP.wsSend(connection, wsOpCode(op), data)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

/* Read the next complete message. Fragmented messages are reassembled before
   they are returned. `nothing` means the connection is finished (the peer
   closed cleanly or a close frame was already reported); an error means the
   connection failed. */
public function wsNext(connection :: int) returns Message | nothing | error.StdError {
    const status is HTTP.wsNext(connection)
    const err is HTTP.takeLastErrorCode()
    if err != 0 then return mapIOError(err)
    if status == 0 then return nothing
    const code is HTTP.wsMessageOp(connection)
    const data is HTTP.wsMessageData(connection)
    return $Message {
        op is wsOpFromCode(code),
        data is data,
    }
}

/* Whether undecoded bytes are already buffered for the connection. A poll loop
   uses `while std.http.wsBuffered(handle) { ... wsNext ... }` to drain frames
   that arrived with (or pipelined behind) the handshake before waiting on
   another readiness event. */
public function wsBuffered(connection :: int) returns tetra {
    return HTTP.wsBuffered(connection)
}

/* One readiness event from `poll`. `kind` is 1 for a freshly accepted
   connection, 2 for a connection with bytes to read, and 3 for a peer that
   closed or errored. `handle` is the connection (or listener) handle. */
public struct Event {
    public handle :: int,
    public kind :: int,
}

/* Wait for readiness across the listener and every live connection. Blocks up
   to `timeout_ms` (0 polls immediately, negative waits indefinitely) and
   returns the events that fired. */
public function poll(listener :: int, timeout_ms :: int) returns Event[] {
    HTTP.poll(listener, timeout_ms)
    var events :: Event[]
    const count is HTTP.eventCount()
    for i while i < count do i += 1 {
        @push(events, $Event {
            handle is HTTP.eventHandle(i),
            kind is HTTP.eventKind(i),
        })
    }
    return events
}

public struct Route {
    public id :: int,
    public pattern :: string,
    param_names :: string[],
    param_values :: string[],

    public method param(name :: string) returns string | nothing {
        for i while i < @length(this.param_names) do i += 1 {
            if this.param_names[i] == name then {
                const found is this.param_values[i]
                return found
            }
        }
        return nothing
    }
}

public struct Router {
    verbs :: string[],
    patterns :: string[],
    ids :: int[],

    public function new() returns Router {
        return $Router {
            verbs is [],
            patterns is [],
            ids is [],
        }
    }

    public method add(verb :: string, pattern :: string, id :: int) {
        @push(this.verbs, verb)
        @push(this.patterns, pattern)
        @push(this.ids, id)
    }
}

public function route(router :: Router, verb :: string, path :: string) returns Route | nothing {
    for i while i < @length(router.patterns) do i += 1 {
        if router.verbs[i] == verb then {
            if HTTP.matchPattern(router.patterns[i], path) == 1 then {
                var names :: string[]
                var values :: string[]
                const count is HTTP.paramCount()
                for j while j < count do j += 1 {
                    @push(names, HTTP.paramNameAt(j))
                    @push(values, HTTP.paramValueAt(j))
                }
                return $Route {
                    id is router.ids[i],
                    pattern is router.patterns[i],
                    param_names is names,
                    param_values is values,
                }
            }
        }
    }
    return nothing
}

public function respond(connection :: int, status :: int, headers :: string, body :: string) returns error.StdError {
    HTTP.respond(connection, status, headers, body)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function close(handle :: int) returns error.StdError {
    HTTP.close(handle)
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function get(url :: string) returns Response | error.StdError {
    return performGet(url, 30000)
}

public function getWithTimeout(url :: string, timeout_ms :: int) returns Response | error.StdError {
    return performGet(url, timeout_ms)
}

public struct Request {
    public headers :: string[],
    public body :: string,
    public timeout_ms :: int,
    public max_redirects :: int,

    public function new() returns Request {
        return $Request {
            headers is [],
            body is "",
            timeout_ms is 30000,
            max_redirects is 3,
        }
    }
}

public function request(verb :: string, url :: string, req :: Request) returns Response | error.StdError {
    var header_blob is ""
    for i while i < @length(req.headers) do i += 1 {
        header_blob is header_blob + req.headers[i] + "\u{d}\u{a}"
    }
    const value is HTTP.performRequest(verb, url, header_blob, req.body, req.timeout_ms, req.max_redirects)
    const status is HTTP.takeStatusCode()
    const headers is HTTP.takeResponseHeaders()
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return $Response {
        status_code is status,
        raw_headers is headers,
        body_text is value,
    }
    return mapIOError(err)
}

public function post(url :: string, req :: Request) returns Response | error.StdError {
    return request("POST", url, req)
}

public function put(url :: string, req :: Request) returns Response | error.StdError {
    return request("PUT", url, req)
}

public function delete(url :: string, req :: Request) returns Response | error.StdError {
    return request("DELETE", url, req)
}

public function head(url :: string, req :: Request) returns Response | error.StdError {
    return request("HEAD", url, req)
}

public function getText(url :: string) returns string | error.StdError {
    const value is HTTP.getText(url, 30000)
    const _status is HTTP.takeStatusCode()
    const _headers is HTTP.takeResponseHeaders()
    const err is HTTP.takeLastErrorCode()
    if err == 0 then return value
    return mapIOError(err)
}

public function checkStatus(response :: Response) returns Response | error.StdError {
    const status is response.statusCode()
    if status < 200 or status >= 300 then return error.IO.HttpStatus
    return response
}
