module zerr from "../zerr/zerr.doxa"

# One line of input, or the end of input.
struct Line {
    public ended :: tetra,
    public text :: string,
}

zig IO {
    const std = @import("std");
    const builtin = @import("builtin");

    /// Line terminator for text streams on this OS (`\r\n` on Windows, `\n` elsewhere), like C++ `std::endl`’s newline part.
    pub fn nativeNewline() []const u8 {
        return switch (builtin.os.tag) {
            .windows => "\r\n",
            else => "\n",
        };
    }

    fn io() std.Io {
        return std.Io.Threaded.global_single_threaded.io();
    }

    /// Write to a raw WASI file descriptor. `std.Io.Threaded`'s syscall path is
    /// not usable under wasi preview1, so IO uses the platform's direct write.
    fn writeWasiFd(fd: i32, text: []const u8) @"DoxaError_zerr.ZigError"!void {
        var rest = text;
        while (rest.len > 0) {
            var iov = [1]std.os.wasi.ciovec_t{.{ .base = rest.ptr, .len = rest.len }};
            var written: usize = 0;
            if (std.os.wasi.fd_write(fd, &iov, 1, &written) != .SUCCESS) return error.WriteFailed;
            rest = rest[written..];
        }
    }

    fn write(file: std.Io.File, fd: i32, text: []const u8, newline: bool) @"DoxaError_zerr.ZigError"!void {
        if (builtin.os.tag == .wasi) {
            try writeWasiFd(fd, text);
            if (newline) try writeWasiFd(fd, nativeNewline());
            return;
        }
        var buffer: [1024]u8 = undefined;
        var file_writer = file.writerStreaming(io(), &buffer);
        const writer = &file_writer.interface;
        try writer.writeAll(text);
        if (newline) try writer.writeAll(nativeNewline());
        try writer.flush();
    }

    pub fn print(text: []const u8) @"DoxaError_zerr.ZigError"!void {
        return write(std.Io.File.stdout(), 1, text, false);
    }

    pub fn println(text: []const u8) @"DoxaError_zerr.ZigError"!void {
        return write(std.Io.File.stdout(), 1, text, true);
    }

    pub fn eprint(text: []const u8) @"DoxaError_zerr.ZigError"!void {
        return write(std.Io.File.stderr(), 2, text, false);
    }

    pub fn eprintln(text: []const u8) @"DoxaError_zerr.ZigError"!void {
        return write(std.Io.File.stderr(), 2, text, true);
    }

    // Every read of standard input goes through one reader, so a byte read
    // after a line sees what the line read buffered past it. The reader and
    // its buffer outlive each call for the same reason.
    fn stdin() *std.Io.Reader {
        const State = struct {
            var buffer: [4096]u8 = undefined;
            var reader: ?std.Io.File.Reader = null;
        };
        if (State.reader == null) {
            State.reader = std.Io.File.stdin().reader(io(), &State.buffer);
        }
        return &State.reader.?.interface;
    }

    pub fn input() @"DoxaError_zerr.ZigError"!DoxaStruct_Line {
        // TODO(wasi): read through `std.os.wasi.fd_read`; `std.Io.Threaded`'s
        // reader path is unusable under wasi preview1, so line input reads as
        // the end of input on that target.
        if (builtin.os.tag == .wasi) return .{ .ended = true, .text = "" };
        // The returned line is a view into the reader's buffer; the wrapper
        // copies it before the next read can move it.
        var line = try stdin().takeDelimiter('\n') orelse return .{ .ended = true, .text = "" };
        if (line.len > 0 and line[line.len - 1] == '\r') {
            line = line[0 .. line.len - 1];
        }
        return .{ .ended = false, .text = line };
    }

    /// One byte from stdin without line buffering, or -1 at the end of input.
    pub fn inputByte() @"DoxaError_zerr.ZigError"!i64 {
        var byte: [1]u8 = undefined;
        if (builtin.os.tag == .wasi) {
            var iov = [1]std.os.wasi.iovec_t{.{ .base = &byte, .len = 1 }};
            var nread: usize = 0;
            if (std.os.wasi.fd_read(0, &iov, 1, &nread) != .SUCCESS) return error.ReadFailed;
            return if (nread == 0) -1 else byte[0];
        }
        return stdin().takeByte() catch |err| switch (err) {
            error.EndOfStream => -1,
            else => |e| e,
        };
    }
}

public function print(text :: string) returns nothing | zerr.ZigError {
    return IO.print(text)
}

public function println(text :: string) returns nothing | zerr.ZigError {
    return IO.println(text)
}

public function eprint(text :: string) returns nothing | zerr.ZigError {
    return IO.eprint(text)
}

public function eprintln(text :: string) returns nothing | zerr.ZigError {
    return IO.eprintln(text)
}

# The next line of standard input, without its line ending, or `nothing` at
# the end of input.
public function input() returns string | nothing | zerr.ZigError {
    const line is IO.input() as Line else {
        return line
    }
    if line.ended then return nothing
    return line.text
}

# The next byte of standard input, or `nothing` at the end of input.
public function inputByte() returns byte | nothing | zerr.ZigError {
    const value is IO.inputByte() as int else {
        return value
    }
    if value < 0 then return nothing
    return @byte(value)
}

# `print(prompt)`, then `input()`.
public function inputPrompt(prompt :: string) returns string | nothing | zerr.ZigError {
    const printed is print(prompt)
    printed as zerr.ZigError then return printed else {}
    return input()
}
