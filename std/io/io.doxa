module error from "../error.doxa"

zig IO {
    const std = @import("std");
    const builtin = @import("builtin");

    /// Line terminator for text streams on this OS (`\r\n` on Windows, `\n` elsewhere), like C++ `std::endl`’s newline part.
    pub fn nativeNewline() []const u8 {
        return switch (builtin.os.tag) {
            .windows => "\r\n",
            else => "\n",
        };
    }

    pub fn printlnStdout(text: []const u8) void {
        const alloc = std.heap.page_allocator;
        const buf = std.mem.concat(alloc, u8, &.{ text, nativeNewline() }) catch {
            clearLastError();
            setLastError(2);
            return;
        };
        defer alloc.free(buf);
        print(buf);
    }

    pub fn eprintlnStderr(text: []const u8) void {
        const alloc = std.heap.page_allocator;
        const buf = std.mem.concat(alloc, u8, &.{ text, nativeNewline() }) catch {
            clearLastError();
            setLastError(2);
            return;
        };
        defer alloc.free(buf);
        eprint(buf);
    }

    pub fn errorState(mode: i64, value: i64) i64 {
        const State = struct {
            var last_error_code: i64 = 0;
        };
        if (mode == 0) {
            State.last_error_code = value;
            return 0;
        }
        if (mode == 1) {
            return State.last_error_code;
        }
        if (mode == 2) {
            const code = State.last_error_code;
            State.last_error_code = 0;
            return code;
        }
        return 0;
    }

    pub fn clearLastError() void {
        _ = errorState(0, 0);
    }

    pub fn setLastError(code: i64) void {
        _ = errorState(0, code);
    }

    pub fn takeLastErrorCode() i64 {
        return errorState(2, 0);
    }

    /// Write to a raw WASI file descriptor. `std.Io.Threaded`'s syscall path is
    /// not usable under wasi preview1, so IO uses the platform's direct write.
    fn writeWasiFd(fd: i32, text: []const u8) void {
        if (text.len == 0) return;
        var iov = [1]std.os.wasi.ciovec_t{.{ .base = text.ptr, .len = text.len }};
        var written: usize = 0;
        _ = std.os.wasi.fd_write(fd, &iov, 1, &written);
    }

    pub fn print(text: []const u8) void {
        clearLastError();
        if (builtin.os.tag == .wasi) {
            writeWasiFd(1, text);
            return;
        }
        var stdout_buffer: [1024]u8 = undefined;
        var stdout_writer = std.Io.File.stdout().writer(std.Io.Threaded.global_single_threaded.io(), &stdout_buffer);
        const stdout = &stdout_writer.interface;

        stdout.print("{s}", .{text}) catch {
            setLastError(107);
            return;
        };

        stdout.flush() catch {
            setLastError(107);
            return;
        };
    }

    pub fn eprint(text: []const u8) void {
        clearLastError();
        if (builtin.os.tag == .wasi) {
            writeWasiFd(2, text);
            return;
        }
        var stderr_buffer: [1024]u8 = undefined;
        var stderr_writer = std.Io.File.stderr().writer(std.Io.Threaded.global_single_threaded.io(), &stderr_buffer);
        const stderr = &stderr_writer.interface;

        stderr.print("{s}", .{text}) catch {
            setLastError(107);
            return;
        };

        stderr.flush() catch {
            setLastError(107);
            return;
        };
    }

    pub fn input() []const u8 {
        clearLastError();
        // TODO(wasi): read through `std.os.wasi.fd_read`; `std.Io.Threaded`'s
        // reader path is unusable under wasi preview1, so line input degrades to
        // the empty string on that target.
        var stdin_buffer: [4096]u8 = undefined;
        var stdin_reader = std.Io.File.stdin().reader(std.Io.Threaded.global_single_threaded.io(), &stdin_buffer);
        const stdin = &stdin_reader.interface;

        var line = stdin.takeDelimiterExclusive('\n') catch {
            setLastError(106);
            return "";
        };

        if (line.len > 0 and line[line.len - 1] == '\r') {
            line = line[0 .. line.len - 1];
        }

        const State = struct {
            var cache: ?[]u8 = null;
        };

        if (State.cache) |prev| {
            std.heap.page_allocator.free(prev);
        }

        const duped = std.heap.page_allocator.dupe(u8, line) catch {
            setLastError(106);
            return "";
        };

        State.cache = duped;
        return duped;
    }

    /// Read a single byte from stdin without line buffering. Returns `-1` and
    /// sets the read-failed error at end of input, so callers can map EOF to a
    /// value of their choosing.
    pub fn inputByte() i64 {
        clearLastError();
        var byte: [1]u8 = undefined;
        if (builtin.os.tag == .wasi) {
            var iov = [1]std.os.wasi.iovec_t{.{ .base = &byte, .len = 1 }};
            var nread: usize = 0;
            if (std.os.wasi.fd_read(0, &iov, 1, &nread) != .SUCCESS or nread == 0) {
                setLastError(106);
                return -1;
            }
            return @intCast(byte[0]);
        }
        const n = std.posix.read(0, &byte) catch {
            setLastError(106);
            return -1;
        };
        if (n == 0) {
            setLastError(106);
            return -1;
        }
        return @intCast(byte[0]);
    }

    pub fn inputPrompt(prompt: []const u8) []const u8 {
        print(prompt);
        if (errorState(1, 0) != 0) {
            return "";
        }
        return input();
    }
}

function mapIOError(code :: int) returns error.StdError {
    return match code {
        1 then error.Common.InvalidArgument,
        2 then error.Common.OutOfMemory,
        3 then error.Common.PermissionDenied,
        4 then error.Common.NotSupported,
        5 then error.Common.Unexpected,
        100 then error.IO.NotFound,
        101 then error.IO.AlreadyExists,
        102 then error.IO.NotDirectory,
        103 then error.IO.IsDirectory,
        104 then error.IO.InvalidPath,
        105 then error.IO.OpenFailed,
        106 then error.IO.ReadFailed,
        107 then error.IO.WriteFailed,
        108 then error.IO.CreateFailed,
        109 then error.IO.DeleteFailed,
        110 then error.IO.RenameFailed,
        111 then error.IO.CopyFailed,
        112 then error.IO.IterateFailed,
        113 then error.IO.InvalidData,
        114 then error.IO.ConnectionFailed,
        115 then error.IO.Timeout,
        116 then error.IO.HttpStatus,
        117 then error.IO.Unexpected,
        else error.Common.Unexpected,
    }
}

public function print(input :: string) returns error.StdError {
    IO.print(input);
    const err is IO.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function println(input :: string) returns error.StdError {
    IO.printlnStdout(input);
    const err is IO.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function eprint(input :: string) returns error.StdError {
    IO.eprint(input);
    const err is IO.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function eprintln(input :: string) returns error.StdError {
    IO.eprintlnStderr(input);
    const err is IO.takeLastErrorCode()
    if err == 0 then return
    return mapIOError(err)
}

public function input() returns string | error.StdError {
    const value is IO.input();
    const err is IO.takeLastErrorCode()
    if err == 0 then return value
    return mapIOError(err)
}

public function inputByte() returns byte | error.StdError {
    const value is IO.inputByte()
    const err is IO.takeLastErrorCode()
    if err == 0 then return @byte(value)
    return mapIOError(err)
}

public function inputPrompt(prompt :: string) returns string | error.StdError {
    const value is IO.inputPrompt(prompt);
    const err is IO.takeLastErrorCode()
    if err == 0 then return value
    return mapIOError(err)
}
