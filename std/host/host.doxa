zig Host {
    const builtin = @import("builtin");

    pub fn osName() []const u8 {
        return @tagName(builtin.os.tag);
    }

    pub fn archName() []const u8 {
        return @tagName(builtin.cpu.arch);
    }

    pub fn abiName() []const u8 {
        return @tagName(builtin.abi);
    }

    pub fn isWindows() bool {
        return builtin.os.tag == .windows;
    }

    pub fn isLinux() bool {
        return builtin.os.tag == .linux;
    }

    pub fn isMac() bool {
        return builtin.os.tag == .macos;
    }
}

public function os() returns string {
    return Host.osName();
}

public function arch() returns string {
    return Host.archName();
}

public function abi() returns string {
    return Host.abiName();
}

public function isWindows() returns tetra {
    return Host.isWindows();
}

public function isLinux() returns tetra {
    return Host.isLinux();
}

public function isMac() returns tetra {
    return Host.isMac();
}

# True when `ch` is a path separator for `platform`: `/` everywhere, and `\` on
# Windows.
function isSep(ch :: string, platform :: string) returns tetra {
    if ch == "/" then return true
    if platform == "windows" {
        if ch == "\\" then return true
    }
    return false
}

# The separator joined between segments for `platform`.
function sepFor(platform :: string) returns string {
    if platform == "windows" then return "\\"
    return "/"
}

# True when `part` is an absolute path for `platform`: a leading separator, or a
# Windows drive root such as `C:\` or `C:/`.
function isAbsolute(part :: string, platform :: string) returns tetra {
    if @length(part) == 0 then return false
    if isSep(part[0], platform) then return true
    if platform == "windows" {
        if @length(part) >= 2 {
            if part[1] == ":" then return true
        }
    }
    return false
}

# Joins `parts` with the separator for `platform` (one of the names returned by
# `os()`, e.g. `"windows"`, `"linux"`, `"macos"`). Empty segments are skipped,
# an absolute segment resets the result, and a separator already at the join
# point is not doubled.
public function pathFor(platform :: string, parts :: string[]) returns string {
    const sep is sepFor(platform)
    var result is ""
    var i is 0
    while i < @length(parts) {
        const part is parts[i]
        if @length(part) == 0 then {
            i is i + 1
            continue
        }

        if isAbsolute(part, platform) then {
            result is part
        } else if @length(result) == 0 then {
            result is part
        } else if isSep(result[@length(result) - 1], platform) then {
            result is result + part
        } else {
            result is result + sep + part
        }
        i is i + 1
    }
    return result
}

# Joins `parts` with the host OS's separator. See `pathFor`.
public function path(parts :: string[]) returns string {
    return pathFor(os(), parts)
}
