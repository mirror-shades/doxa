# A callee the borrow check cannot see empties the global an `each` borrows:
# the element is re-indexed on every use, so the store meets a bounds check,
# never a stale buffer (plan/plain-store-copies.md step 3, rule 3).
var items is [1, 2, 3]

function empty() {
    @clear(items)
}

entry function main() {
    each n in ^items {
        empty()
        n is 5
    }
    @print("unreached\n")
}
