function pw(a :: int, b :: int) returns int {
    return a ** b
}
@print("{pw(3, 35)} {pw(-2, 63)} {pw(2, 62)} {pw(-3, 3)} {pw(2, -1)} {pw(1, -5)} {pw(-1, -3)} {pw(-1, -4)} {pw(0, 0)} {pw(7, 0)} {pw(3037000499, 2)} {pw(65536, 3)}\n")
@print("{3 ** 35} {-2 ** 63} {2 ** 62} {-3 ** 3} {2 ** -1} {1 ** -5} {-1 ** -3} {-1 ** -4} {0 ** 0} {7 ** 0} {3037000499 ** 2} {65536 ** 3}\n")
