# A block is a lifetime: what it allocates is reclaimed at its `}`, and
# what leaves it (a stored value, its own value, a return) is copied out
# first. The caller's arena is churned after each, so a value left pointing
# into a block's reclaimed arena would be overwritten (and memcheck faults).
function build(n :: int) returns int[] {
    var out :: int[] is []
    for i while i < n do i += 1 {
        @push(out, i * 3)
    }
    return out
}

function churn() {
    var junk :: string[] is []
    for i while i < 200 do i += 1 {
        @push(junk, "junk-{i}")
    }
}

# A large value used only inside the block; the result is copied out.
function pick(id :: int) returns int[] {
    var result :: int[] is []
    {
        const list is build(1000)
        result is [list[id], list[id + 1]]
    }
    churn()
    return result
}

# The block's own value leaves it.
function label(id :: int) returns string {
    const text is {
        const head is "id-{id}"
        "{head}!"
    }
    churn()
    return text
}

# A return out of the block closes it on the way out.
function early(id :: int) returns string {
    {
        const t is "early-{id}"
        if id > 2 then return t
    }
    return "small"
}

# A block in a loop body is reclaimed every iteration.
function collect() returns string[] {
    var names :: string[] is []
    for i while i < 4 do i += 1 {
        {
            const n is "n{i}"
            @push(names, n)
        }
        churn()
    }
    return names
}

entry function main() {
    @print("{pick(7)}\n")
    @print("{label(3)}\n")
    @print("{early(5)} {early(1)}\n")
    @print("{collect()}\n")
}
