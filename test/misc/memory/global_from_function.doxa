# Globals stored from inside a function live in the root arena: once the
# function returns they are still whole, and mutating them afterwards writes
# through the root-owned value.
struct Point {
    public label :: string,
    public x :: int,
}

var names :: string[] is []
var origin :: Point is $Point { label is "none", x is 0 }
var tagged :: string | int[] is "none"

function fill(n :: int) {
    var local :: string[] is []
    for i while i < n do i += 1 {
        @push(local, "name-{i}")
    }
    names is local
    origin is $Point { label is "set-{n}", x is n }
    tagged is [n, n * 10]
}

public entry function main() {
    fill(3)
    @push(names, "late")
    names[0] is "first"
    origin.x is origin.x + 100
    origin.label is "moved"
    @print("{names}\n")
    @print("{origin.label} {origin.x}\n")
    @print("{tagged}\n")
}
