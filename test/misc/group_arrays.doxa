# A group array stores each element as its whole box, so every element keeps
# the member it is through every array operation.

enum IOError { NotFound, Denied }
enum ParseError { BadToken, Eof }
struct FileError { public path :: string, public code :: int }
group Error { IOError, ParseError, FileError }
function d(e :: Error) returns string {
    return match e {
        IOError then "io",
        ParseError then "parse",
        FileError then "file:" + e.path,
    }
}
function all(xs :: Error[]) returns string {
    var out is ""
    each x in xs { out is out + d(x) + " " }
    return out
}
function build() returns Error[] {
    var xs :: Error[] is []
    @push(xs, ParseError.Eof)
    @push(xs, $FileError { path is "tmp" + "/x", code is 1 })
    @push(xs, IOError.Denied)
    return xs
}
var errs is build()
@print("built:   {all(errs)}\n")
errs[0] is IOError.NotFound
@print("set:     {all(errs)}\n")
@insert(errs, 1, ParseError.BadToken)
@print("insert:  {all(errs)}\n")
const removed is @remove(errs, 2)
@print("remove:  {d(removed)} | {all(errs)}\n")
const popped is @pop(errs)
@print("pop:     {d(popped)} | {all(errs)}\n")
const joined is errs + build()
@print("concat:  {all(joined)}\n")
@print("slice:   {all(@slice(joined, 1, 3))}\n")
@print("index:   {d(joined[4])} len {@length(joined)}\n")
var grid :: Error[][] is []
@push(grid, build())
@print("nested:  {all(grid[0])}\n")
function local() {
    var ys :: Error[] is []
    @push(ys, ParseError.Eof)
    @push(ys, IOError.Denied)
    @print("local:   {all(ys)} {ys[1] == IOError.Denied} {ys[0] == IOError.Denied}\n")
}
local()

struct Log { public items :: Error[] }
var log is $Log { items is [] }
@push(log.items, ParseError.Eof)
@push(log.items, IOError.Denied)
@print("field:   {d(log.items[0])} {d(log.items[1])}\n")
var fixed :: Error[2]
fixed[0] is ParseError.Eof
fixed[1] is IOError.Denied
@print("fixed:   {d(fixed[0])} {d(fixed[1])}\n")
