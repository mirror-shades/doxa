function maybeInt(s :: string) returns int | nothing {
    if s == "" then return nothing
    return 5
}

# `as` fallback continues instead of yielding a value
function sumSkippingBlanks(items :: string[]) returns int {
    var total is 0
    for i while i < @length(items) do i += 1 {
        const v is maybeInt(items[i]) as int else continue
        total += v
    }
    return total
}

# `as` fallback returns instead of yielding a value
function firstValueOr(items :: string[], fallback :: int) returns int {
    for i while i < @length(items) do i += 1 {
        const v is maybeInt(items[i]) as int else return fallback
        return v
    }
    return -1
}

# `as` success branch diverges
function countBlanks(items :: string[]) returns int {
    var n is 0
    for i while i < @length(items) do i += 1 {
        maybeInt(items[i]) as int then continue else n += 1
    }
    return n
}

# `if` else branch continues
function countNonBlank(items :: string[]) returns int {
    var n is 0
    for i while i < @length(items) do i += 1 {
        if items[i] != "" then n += 1 else continue
    }
    return n
}

# `if` else branch returns
function firstNonBlank(items :: string[]) returns string {
    for i while i < @length(items) do i += 1 {
        if items[i] != "" then return items[i] else continue
    }
    return "none"
}

# `match` else arm continues
function tagOf(s :: string, items :: string[]) returns int {
    var out is 0
    for i while i < @length(items) do i += 1 {
        match s {
            "a" then out is 1,
            else continue
        }
        out += 10
    }
    return out
}

# `match` pattern arm breaks
function scanUntilZ(s :: string) returns int {
    var out is 0
    for i is 0 while i < 3 do i += 1 {
        match s {
            "a" then out is 1,
            "z" then break,
            else out is 99,
        }
        out += 10
    }
    return out
}

const list is ["a", "", "b"]
@print("sum       = {sumSkippingBlanks(list)}\n")
@print("first     = {firstValueOr(list, -1)}\n")
@print("firstMiss = {firstValueOr([""], -1)}\n")
@print("blanks    = {countBlanks(list)}\n")
@print("nonBlank  = {countNonBlank(list)}\n")
@print("firstStr  = {firstNonBlank(list)}\n")
@print("firstNone = {firstNonBlank([""])}\n")
@print("tagZ      = {tagOf("z", list)}\n")
@print("tagA      = {tagOf("a", list)}\n")
@print("scanA     = {scanUntilZ("a")}\n")
@print("scanZ     = {scanUntilZ("z")}\n")