# Pins B (plain stores copy; only `^` shares, plan/plain-store-copies.md): a
# struct-typed local initialised from another struct is a copy, so a write
# through one name is not seen through the other. Before B this aliased when
# both lived in one arena, and the outcome depended on where the value lived.
struct Cell {
    value :: int,

    public function new(start :: int) returns Cell {
        return $Cell { value is start }
    }

    public method get() returns int {
        return this.value
    }

    public method set(v :: int) {
        this.value is v
    }
}

entry function main() {
    const original is Cell.new(1)
    const copy is original

    @print("before {original.get()} {copy.get()}\n")

    copy.set(42)

    @print("after {original.get()} {copy.get()}\n")
}
