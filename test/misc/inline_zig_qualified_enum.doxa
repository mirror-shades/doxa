module std from @std()
import error from @std()

# `DoxaEnum_<path>` resolves through the declaring file's own bindings. A
# qualified path is spelled as a Zig quoted identifier: this file binds the
# namespace `error`, so `error.Method` is `@"DoxaEnum_error.Method"`.
zig Z {
    pub fn is_oob(m: @"DoxaEnum_error.Method") i64 {
        return if (m == 0) 1 else 0;
    }
}

entry function main() {
    @print("{@string(Z.is_oob(std.error.Method.OutOfBounds))}\n")
    # Converting the literal directly (not through a call argument) must still
    # resolve the qualified name; a conversion builtin analyzes its operand.
    @print("{@string(error.Method.OutOfBounds)}\n")
    const m is std.error.Method.EmptyCollection
    @print("{m}\n")
}
