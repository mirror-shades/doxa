# Regression: a `const` bound to a runtime call is not a compile-time 0.
# Folding that placeholder would delete the `if` body. Covers both a user
# function and `process.argc()` (`doxa run file -- hello`).
import process from @std()

function two() returns int {
    return 2
}

const n is two()
if n > 1 then {
    @print("yes\n")
}

const argc is process.argc() as int else 0
if argc > 1 then {
    @print("checking for args\n")
}
