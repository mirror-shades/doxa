# Malformed-frame probes share one listener; the server closes each failed
# connection, so the next probe starts clean.
WsFixture.start(malformed_port, 5)
const overflow_served is serve(malformed_listener)
WsFixture.finish()
@print("overflow {WsFixture.resultAt(0)} {overflow_served}\n")

