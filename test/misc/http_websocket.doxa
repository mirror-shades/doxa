# Partial-frame multiplex: one client writes half a frame and pauses; a second
# client must still be served, and the first finishes once it sends the rest.
WsFixture.startTwo(partial_port, 10, 11)
const partial_served is servePair(partial_listener, 4)
WsFixture.finish()
std.http.close(partial_listener)
@print("partial stalled {WsFixture.resultAt(0)}\n")
@print("partial fast {WsFixture.resultAt(1)}\n")
@print("partial served {partial_served}\n")

# The same mode-1 client driven through the Go-flavoured wsAccept/wsRead sugar.
WsFixture.start(sugar_port, 1)
const sugar_served is serveSugar(sugar_listener)
WsFixture.finish()
std.http.close(sugar_listener)
@print("sugar echo {WsFixture.resultAt(0)}\n")
@print("sugar fragmented {WsFixture.resultAt(1)}\n")
@print("sugar ping {WsFixture.resultAt(2)}\n")
@print("sugar close {WsFixture.resultAt(3)}\n")
@print("sugar served {sugar_served}\n")

# A plain request to a WebSocket-only server is answered 426, not left hanging.
WsFixture.start(plain_port, 12)
const plain_reason is serveUntilClosed(plain_listener)
WsFixture.finish()
@print("plain 426 {WsFixture.resultAt(0)} {plain_reason == std.http.CloseReason.PeerClosed}\n")

# A WebSocket peer that goes silent is closed at the idle deadline.
std.http.setLimit(std.http.Limit.IdleMs, 200)
WsFixture.start(plain_port, 13)
const idle_reason is serveUntilClosed(plain_listener)
WsFixture.finish()
std.http.setLimit(std.http.Limit.IdleMs, 120000)
std.http.close(plain_listener)
@print("idle closed {WsFixture.resultAt(0)} {idle_reason == std.http.CloseReason.IdleTimeout}\n")

# A burst of frames is reported once per poll, not once per frame.
WsFixture.start(burst_port, 14)
const burst_most is serveBurst(burst_listener)
WsFixture.finish()
std.http.close(burst_listener)
@print("burst {WsFixture.resultAt(0)} most {burst_most}\n")
