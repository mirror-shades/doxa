import error from @std()

# A misspelled error name is a Zig compile error in the block. It is reported
# at the name's own line and column in this file, never in the cached wrapper.
zig Fs {
    pub fn mightFail(n: i64) @"DoxaError_error.IO"!i64 {
        if (n == 0) return error.NotFuond;
        return n;
    }
}

entry function main() {
    @print("{Fs.mightFail(3)}\n")
}
