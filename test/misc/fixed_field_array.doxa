# Regression: a fixed-size array stored in a struct field is promoted to a
# heap nested array on construction, so returning the struct clones the field
# instead of treating the inline stack buffer as an ArrayHeader. Also pins
# `is []` zero-filling the declared fixed dimensions (1-D and 2-D).

struct Board {
    state :: tetra[8][8]
    weights :: int[3]

    public function new() returns Board {
        var cells :: tetra[8][8] is []
        cells[3][4] is both
        var w :: int[3] is []
        w[1] is 9
        return $Board {
            state is cells,
            weights is w
        }
    }

    public method getState() returns tetra[][] {
        return this.state
    }

    public method getWeights() returns int[] {
        return this.weights
    }
}

public entry function main() {
    var board is Board.new()
    var cells is board.getState()
    @print("{@length(cells)} {@length(cells[0])} {cells[0][0]} {cells[3][4]}\n")
    var w is board.getWeights()
    @print("{@length(w)} {w[0]} {w[1]} {w[2]}\n")
}
