module build from "std/build/build.doxa"
module host from "std/host/host.doxa"

build.compile("./test/misc/bigfile.doxa", "./test/out/bigfile", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/complex_print.doxa", "./test/out/complex_print", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/expressions.doxa", "./test/out/expressions", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/array_storage_migration.doxa", "./test/out/array_storage_migration", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/alias_arrays.doxa", "./test/out/alias_arrays", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/methods.doxa", "./test/out/methods", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/union_enum_return.doxa", "./test/out/union_enum_return", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/inline_zig_string.doxa", "./test/out/inline_zig_string", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/inline_zig_test.doxa", "./test/out/inline_zig_test", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/zig_import_test.doxa", "./test/out/zig_import_test", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/module_private_call.doxa", "./test/out/module_private_call", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/import_submodule.doxa", "./test/out/import_submodule", host.arch(), host.os(), host.abi(), true)
build.compile("./test/examples/brainfuck.doxa", "./test/out/brainfuck", host.arch(), host.os(), host.abi(), true)
build.compile("./test/examples/calculator.doxa", "./test/out/calculator", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/http_link_test.doxa", "./test/out/http_link_test", host.arch(), host.os(), host.abi(), true)
build.compile("./test/misc/list.doxa", "./test/out/list", host.arch(), host.os(), host.abi(), true)

# Multi-artifact build through `execute`: exercises Context/Builder/execute and
# the artifact-level up-to-date skip, with the process exit code as the signal.
var fixture is build.Context.host()
fixture.debug is true
var fixture_hello is build.Builder.executable("hello", "test/build/src/hello.doxa", "test/out/build-fixture/hello")
var fixture_other is build.Builder.executable("other", "test/build/src/other.doxa", "test/out/build-fixture/other")
fixture.addArtifact(fixture_hello)
fixture.addArtifact(fixture_other)
build.execute(fixture, false)
