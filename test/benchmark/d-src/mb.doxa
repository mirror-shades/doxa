module std from @std()

# const SIZE is 400
const SIZE is 2000
# const WARM_SIZE is 128
const WARM_SIZE is 256

public entry function main() {
    # Warm-up: a smaller mandelbrot pass before timing.
    var warm is 0
    for y while y < WARM_SIZE do y++ {
        for x while x < WARM_SIZE do x++ {
            var cr is (x - WARM_SIZE / 2.0) / (WARM_SIZE / 4.0)
            var ci is (y - WARM_SIZE / 2.0) / (WARM_SIZE / 4.0)
            var zr is 0.0
            var zi is 0.0
            var iter is 0
            while zr * zr + zi * zi < 4.0 and iter < 1000 {
                var tmp is zr * zr - zi * zi + cr
                zi is 2.0 * zr * zi + ci
                zr is tmp
                iter += 1
            }
            warm += iter
        }
    }

    var count :: int

    const t0 is std.time.monotonic()

    for y while y < SIZE do y++ {
        for x while x < SIZE do x++ {

            var cr is (x - SIZE / 2.0) / (SIZE / 4.0)
            var ci is (y - SIZE / 2.0) / (SIZE / 4.0)

            var zr is 0.0
            var zi is 0.0

            var iter is 0

            while zr * zr + zi * zi < 4.0 and iter < 1000 {
                var tmp is zr * zr - zi * zi + cr
                zi is 2.0 * zr * zi + ci
                zr is tmp
                iter += 1
            }

            count += iter
        }
    }

    const t1 is std.time.monotonic()

    const out is count + warm
    std.io.println("{t1 - t0}, {out}")
}
