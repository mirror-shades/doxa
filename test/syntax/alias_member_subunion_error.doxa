# Narrowing to a smaller union does not pin the member: in the `else` branch
# `x` is `string | float`, so storing a float there could change a string.
function sneaky(^x :: int | string | float) {
    x as int then {
        x is x + 1
    } else {
        x is 1.5
    }
}

var s :: string is "hi"
sneaky(^s)
@print("{s}\n")
