import Pair from "./types.doxa"

public struct Context {
    name :: string
    literal :: string
    line_breaks :: int[]
    # TODO: add hash :: int for caching

    public function new(_name :: string, _literal :: string, _line_breaks :: int[]) returns Context {
        return $Context {
            name is _name
            literal is _literal
            line_breaks is _line_breaks
        }
    }
}

public struct SourceManager {
    files :: Context[]

    public function new() returns SourceManager {
        return $SourceManager {
            files is []
        }
    }

    public method addFile(_name :: string, _literal :: string, _line_breaks :: int[]) {
        @push(this.files, Context.new(_name, _literal, _line_breaks))
    }

    public method getFile(_name :: string) returns Context {
        each context in this.files {
            if context.name == _name then return context
        }
        @panic("no source file named {_name}")
    }

    public method getLineColumn(file :: string, offset :: int) returns Pair {
        const line_break_context is this.getFile(file).line_breaks
        var line_number is 1
        each lb in line_break_context {
            if offset > lb then {
                line_number is line_number + 1
            } else {
                break
            }
        }
        const prev_line_break is if line_number > 1 then line_break_context[line_number - 2] else 0
        const column is offset - prev_line_break
        return $Pair { a is line_number, b is column }
    }

    public method hasFile(_name :: string) returns tetra {
        each context in this.files {
            if context.name == _name then return true
        }
        return false
    }
}
